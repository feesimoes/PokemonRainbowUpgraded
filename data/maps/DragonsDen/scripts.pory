mapscripts DragonsDen_MapScripts 
{
    MAP_SCRIPT_ON_LOAD
    {
        setworldmapflag(FLAG_WORLD_MAP_DRAGONS_DEN)
    }
}

script DragonsDen_PagodaShrine_Sign
{
    lock
    msgbox(format("DRAGONS' DEN PAGODA -\nDRAGONS' SHRINE"))   
    closemessage
    release
    end
}

script DragonsDen_RockfallWarning_Sign
{
    lock
    msgbox(format("Beware of dangerous rockslides\ncaused by GOLEM!\pThe exit to BLACKTHORN CITY is\nfurther up ahead."))   
    closemessage
    release
    end
}

script DragonsDen_ElderDragonMaster
{
    lock
    faceplayer
    if (flag(FLAG_JOHTO_BADGE08_GET) == TRUE)
    {
        msgbox(format("Congratulations on the RISING BADGE.\nAh, but...\pThe DRAGONS' SHRINE still does not\nexpect you here so soon."))
    }
    else
    {
        msgbox(format("Hm... Hello.\nA visitor? Ah, I see...\pIf you wish to earn CLAIR'S\nBADGE, you will need Dragons Janitor's bless."), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
            msgbox(format("I can give you a tip...\nThe only one who knows where he is, is Celio."))
            msgbox(format("Celio is on Sevii Island One.\nFly there and help with Ruby and Sapphire."))            
            msgbox(format("Then he will tell you where the Dragons Janitor is."))
        }
        else
        {
            msgbox(format("Hm.\nFigure it out yourself, eh?\pSome smart adventurer you are!"))
        }
    }
    closemessage
    release
    end
}