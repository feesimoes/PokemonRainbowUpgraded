raw `
Route23_EventScript_VictoryRoadGateSign::
	msgbox Route23_Text_VictoryRoadGateSign, MSGBOX_SIGN
	end
`

script Route23_EventScript_CascadeBadgeGuard
{
    lock
    faceplayer
    if (var(VAR_MAP_SCENE_ROUTE23) >= 2)
    {
        msgbox(format("Good luck out there, {PLAYER}!\nMISTY and BROCK, huh?\pOpposites attract, so they say!"))   
    }
    else
    {
        if (flag(FLAG_BADGE02_GET) == TRUE)
        {
            msgbox(format("You can pass here only if you have\nthe CASCADE BADGE."))
            msgbox(format("Oh! Okay, then. That is the\nCASCADE BADGE. Go right ahead!"))
            setvar(VAR_MAP_SCENE_ROUTE23, 2)
            applymovement(LOCALID_CASCADE_BADGE_GUARD, Route23_BadgeGateGuard_Face_Down)
            waitmovement
            playfanfare(MUS_LEVEL_UP)
            waitfanfare
			playbgm(MUS_ROUTE_23_BADGE_2, TRUE)
			playse(SE_UNLOCK)
			waitmessage
			call(Route23_EventScript_Free_Gate_2)
        }
        else
        {
            msgbox(format("You can pass here only if you have\nthe CASCADE BADGE.\pSorry, rules are rules!\nI can't let you through."))
            playse(SE_BOO)
        }
    }
    waitmessage
    closemessage
    release
    end
}


