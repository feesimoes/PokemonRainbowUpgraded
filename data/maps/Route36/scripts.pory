script Route36_Weird_Pidgey 
{
    lock
    msgbox(format("Bark bark!\nI'm a bird."))
    closemessage
    clearflag(FLAG_CAUGHT_SUDOWOODO_ROUTE_36)
    release
    end   
}

script Route36_Weird_Tree 
{
    lock
    if (flag(FLAG_TEMP_12) == TRUE)
    {
        release
    }
    else
    {
        checkitem(ITEM_SQUIRT_BOTTLE, 1)
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        if (var(VAR_RESULT) == TRUE)
        {
            msgbox(format("A strange, wiggly tree blocks the\npath ahead...\pWould you like to water it with\nthe SQUIRT BOTTLE?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES)
            {
                msgbox(format("The weird tree didn't like that!\nIt attacks you... It's a POKéMON!"))
                closemessage
                setwildbattle(SPECIES_SUDOWOODO, 50, ITEM_NONE)
                setflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
                dowildbattle
                clearflag(FLAG_SYS_SPECIAL_WILD_BATTLE)
                specialvar(VAR_RESULT, GetBattleOutcome)
                if (var(VAR_RESULT) == 1)
                {
                    msgbox(format("The POKéMON fled!\nIt'll come back later..."))
                    fadescreen(FADE_TO_BLACK)
                    applymovement(LOCALID_ROUTE36_WEIRD_TREE, Route36_Hide_Sudowoodo)
                    waitmovement
                    fadescreen(FADE_FROM_BLACK)
                }
                elif (var(VAR_RESULT) == 7)
                {
                    setflag(FLAG_CAUGHT_SUDOWOODO_ROUTE_36)
                    fadescreen(FADE_TO_BLACK)
                    applymovement(LOCALID_ROUTE36_WEIRD_TREE, Route36_Hide_Sudowoodo)
                    waitmovement
                    fadescreen(FADE_FROM_BLACK)
                }
                else
                {
                    msgbox(format("Darn...\nThe POKéMON is staying put!"))
                }
            }
            else
            {
                msgbox(format("Not just yet!"))
            }
        }
        else
        {
            msgbox(format("It's a weird, wiggly tree...\nIt looks impossible to CUT..."))
        }
        closemessage
        release
    }
    end
}

movement Route36_NPC_Face_Player 
{
    face_player
    step_end 
}

movement Route36_Hide_Sudowoodo 
{
    set_invisible
    walk_right
    step_end    
}
