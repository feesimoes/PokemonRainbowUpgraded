mapscripts Route36_MapScripts 
{
    MAP_SCRIPT_ON_LOAD
    {
        if (flag(FLAG_CAUGHT_SUDOWOODO_ROUTE_36) == TRUE)
        {
            setflag(FLAG_TEMP_12)
            removeobject(LOCALID_ROUTE36_WEIRD_TREE)
        }
        else
        {
            clearflag(FLAG_TEMP_12)
            addobject(LOCALID_ROUTE36_WEIRD_TREE)
        }
    }
}

script Route36_Youngster_Jack_Battle 
{
    trainerbattle_single(TRAINER_YOUNGSTER_JACK, format("All of my friends laughed at me,\nso now it's my turn!"), format("Hahaha! Oh, wait,\nI see why I was laughed at..."))
    msgbox(format("My battling skills are such a\nbig joke, it's hilarious!"))
    closemessage
    releaseall
    end
}

script Route36_Picnicker_Kristie_Battle 
{
    trainerbattle_single(TRAINER_PICNICKER_KRISTIE, format("Oh no...\nI lost my SQUIRT BOTTLE!"), format("Um...\nSo, could I borrow yours?"))
    msgbox(format("There's a flower shop back in\nGOLDENROD CITY.\pWithout a way to water this\nweird tree, it won't budge..."))
    closemessage
    releaseall
    end
}

script Route36_Super_Nerd 
{
    lock
    faceplayer
    msgbox(format("Oh, you're filling a POKéDEX for\nPROF. OAK?\pYou must be important if he\nentrusted you with that task."))
    closemessage
    release
    end
}

