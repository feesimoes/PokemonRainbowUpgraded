mapscripts SaffronCity_MagnetTrainStation_MapScripts 
{
    MAP_SCRIPT_ON_LOAD
    {
        checkitem(ITEM_MUSIC_PLAYER, 1)
        if (var(VAR_RESULT) == TRUE)
        {
            setflag(FLAG_TEMP_1)
        }
    }
}

script SaffronCity_MagnetTrainStation_EventScript_Lass
{
    lock
    faceplayer
    checkitem(ITEM_MUSIC_PLAYER, 1)
    if (var(VAR_RESULT) == TRUE)
    {
        msgbox(format("Oh, thank goodness!\nThat annoying guy is gone!\pI can use the MAGNET TRAIN!"))
    }   
    else
    {
        msgbox(format("There's an annoying guy blocking\nthat MAGNET TRAIN entrance...\pI do wish someone would do\nsomething about this!"))
    }
    waitmessage
    closemessage
    release
    end
}

script SaffronCity_MagnetTrainStation_EventScript_Fat_Man
{
    lock
    faceplayer
    checkitem(ITEM_MUSIC_PLAYER, 1)
    if (var(VAR_RESULT) == TRUE)
    {
        msgbox(format("Have you been to JOHTO?\nI heard this from a friend...\pBut TEAM ROCKET is operating there\nas well, harming the SLOWPOKE.\pNo crime is too wicked for\nthem, those nasty goons!"))
    }   
    else
    {
        msgbox(format("That guy there seems to be\nblocking the entrance...\pHe keeps telling people to check\nout the HOENN REGION, because...\pApparently, he came from there?\nHe's weird."))
    }
    waitmessage
    closemessage
    release
    end
}

script SaffronCity_MagnetTrainStation_EventScript_Scientist
{
    lock
    faceplayer
    checkitem(ITEM_MUSIC_PLAYER, 1)
    if (var(VAR_RESULT) == TRUE)
    {
        msgbox(format("I'm relieved the MAGNET TRAIN\nis back up and running.\pTEAM ROCKET seems to be gone, too."))
    }   
    else
    {
        msgbox(format("I'm an expert in sciences\nand technologies. But, uh...\pMy studies could have never\nprepared me for a yapping MANIAC."))
    }
    waitmessage
    closemessage
    release
    end
}

script SaffronCity_MagnetTrainStation_EventScript_Boy
{
    lock
    faceplayer
    checkitem(ITEM_MUSIC_PLAYER, 1)
    if (var(VAR_RESULT) == TRUE)
    {
        msgbox(format("I'm so glad that guy is gone."))
    }   
    else
    {
        msgbox(format("There's a guy blocking the\nMAGNET TRAIN entrance! Honestly...\pI just want him to shut up!\nHe's the worst! TEAM ROCKET'S better!"))
    }
    waitmessage
    closemessage
    release
    end
}


script SaffronCity_MagnetTrainStation_EventScript_Rodolfo {
    lock
    faceplayer
    call_if_defeated(TRAINER_RODOLFO, SaffronCity_MagnetTrainStation_EventScript_Rodolfo_PostBattle)
    if (flag(FLAG_HIDE_SILPH_ROCKETS))
    {
        msgbox(format("Hey, good job on beating TEAM\nROCKET! Uh, well I mean...\pTechnically, you didn't beat them\n...not yet, anyways.\pYou did drive them out of SAFFRON\nand SILPH..."))
        waitmessage
        closemessage
        msgbox(format("Anyways, I'm RODOLFO!\nSo, uh, you're {PLAYER}? Yeah, I know.\pHah! That look on your face!\nyou should've seen it!\pI mean, you're obviously becoming\npretty well-known in KANTO, duh."))
        waitmessage
        closemessage
        msgbox(format("I've got something for you, {PLAYER}!\nBut you have to beat me in battle!\pReady?"), MSGBOX_YESNO)
        waitmessage
        if (var(VAR_RESULT) == NO)
        {
            msgbox(format("Well, you're a lucky TRAINER!\nCan you believe I even asked?\pYou can go prepare, I'll just be...\nUh, here... Yeah..."))
            waitmessage
            closemessage
            release
            end
        }
        else
        {
            trainerbattle_single(TRAINER_RODOLFO, format("No, wait!\nI don't have a catchy phrase yet!"), format("Uh, I lost...\nBut, how did you like my battle theme?"))
            release
            end
        }
    }
    else
    {
        msgbox(format("Hey, good job on beating TEAM\nROCKET! Uh, well I mean...\pTechnically, you didn't beat them\n...not yet, anyways.\pYou did drive them out of SAFFRON..."))
        waitmessage
        msgbox(format("Yeah, but, anyways...\nyou should come back later!\pDrive 'em out of SILPH,\nthen, we'll talk!"))
        waitmessage
        closemessage
        release
        end
    }
}

script SaffronCity_MagnetTrainStation_EventScript_Rodolfo_PostBattle
{
    checkitem(ITEM_MUSIC_PLAYER, 1)
    if (var(VAR_RESULT) == TRUE)
    {
        msgbox(format("Sorry, you caught me at a bad\ntime, I was just heading back!\pI'm gonna be in GOLDENROD CITY.\nYou're welcome to stop by."))
        closemessage
        setflag(FLAG_TEMP_1)
        fadescreen(FADE_TO_BLACK)
        removeobject(LOCALID_RODOLFO)
        fadescreen(FADE_FROM_BLACK)
    }
    else
    {
        msgbox(format("Wow, you defeated me, huh?\nThat's crazy... Anyways!\pThat thing I had for you...\nIt's called... The GB SOUNDS!\pHere you go!"))
        waitmessage
        closemessage
        playfanfare(MUS_OBTAIN_KEY_ITEM)
        giveitem(ITEM_MUSIC_PLAYER, 1)
        waitfanfare
        msgbox(format("The GB SOUNDS is a device that\nlets you change the music.\pBut wait, here's the catch!\nIt gives you beeps 'n boops!\pSome sort of GEN 1-2 shenanigans..."))
        waitmessage
        closemessage
        msgbox(format("So, yeah, that's the basics!\nI'm gonna be in GOLDENROD CITY.\pYou're welcome to stop by."))
        waitmessage
        closemessage
        setflag(FLAG_TEMP_1)
        fadescreen(FADE_TO_BLACK)
        removeobject(LOCALID_RODOLFO)
        fadescreen(FADE_FROM_BLACK)
    }
    release
    end
}







script SaffronCity_Badge_Guard
{
    lock
    applymovement(LOCALID_SAFFRONCITY_GUARD, Movement_SaffronCity_Badge_Guard_Face_Player)
    waitmovement
    if (flag(FLAG_JOHTO_BADGE03_GET))
    {
        msgbox(format("...Oh!\nThat is the PLAINBADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_LEVEL_UP}{PAUSE 0x60}{RESUME_MUSIC}\pOkay, then.\nPlease, go right ahead."))
        setvar(VAR_MAP_SCENE_SAFFRONTRAIN, 1)
        waitmessage
        closemessage
        applymovement(LOCALID_SAFFRONCITY_GUARD, Movement_SaffronCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
    else
    {
        msgbox(format("Only truly skilled TRAINERS are\nallowed through.\pYou don't have the PLAINBADGE\nyet! Sorry, rules are rules.\pI can't let you pass."))
        waitmessage
        closemessage
        applymovement(LOCALID_SAFFRONCITY_GUARD, Movement_SaffronCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
}

script SaffronCity_Badge_Guard_Trigger
{
    lock
    applymovement(LOCALID_SAFFRONCITY_GUARD, Movement_SaffronCity_Badge_Guard_Face_Player)
    waitmovement
    msgbox(format("Halt!"))
    waitmessage
    if (flag(FLAG_JOHTO_BADGE03_GET))
    {
        msgbox(format("...Oh!\nThat is the PLAINBADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_LEVEL_UP}{PAUSE 0x60}{RESUME_MUSIC}\pOkay, then.\nPlease, go right ahead."))
        setvar(VAR_MAP_SCENE_SAFFRONTRAIN, 1)
        waitmessage
        closemessage
        applymovement(LOCALID_SAFFRONCITY_GUARD, Movement_SaffronCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
    else
    {
        msgbox(format("Only truly skilled TRAINERS are\nallowed through.\pYou don't have the PLAINBADGE\nyet! Sorry, rules are rules.\pI can't let you pass."))
        waitmessage
        closemessage
        applymovement(LOCALID_PLAYER, Movement_SaffronStation_Walk_Down)
        waitmovement
        applymovement(LOCALID_SAFFRONCITY_GUARD, Movement_SaffronCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
}

movement Movement_SaffronCity_Badge_Guard_Face_Player
{
    face_player
    step_end   
}

movement Movement_SaffronCity_Badge_Guard_Face_Down
{
    face_down
    step_end   
}

movement Movement_SaffronStation_Walk_Down
{
    walk_down
    step_end   
}
