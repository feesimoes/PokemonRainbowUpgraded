script BlackthornCity_Battle_Girl 
{
    lock
    faceplayer
    msgbox(format("Keep following this path uphill\nand you'll see the GYM.\pIt's pretty intimidating!"))
    closemessage
    release
    end
}

script BlackthornCity_Old_Man
{
    lock
    faceplayer
    msgbox(format("This used to be a quiet,\nyet mysterious, small village..."))
    closemessage
    release
    end
}

script BlackthornCity_Old_Woman
{
    lock
    faceplayer
    msgbox(format("An old folk story tells\nof a POKéMON in JOHTO...\pThey say it helped pave\nway for this city."))
    closemessage
    release
    end
}

script BlackthornCity_Man
{
    lock
    faceplayer
    msgbox(format("LORELEI visits us sometimes,\nalthough, strictly business.\pShe's from the ELITE FOUR,\njust like CLAIR'S cousin."))
    closemessage
    release
    end
}