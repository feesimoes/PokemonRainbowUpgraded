mapscripts OlivineCity_Mart_MapScripts {}

script OlivineCity_Mart_Clerk_1 
{        
    lock
    faceplayer
    msgbox(format("Welcome to OLIVINE POKé MART!\nHow can I help you?"))
    waitmessage
    pokemart(Olivine_Mart_1)
    msgbox(format("Thanks for stopping by!\nPlease come again!"))
    closemessage
    release
    end
}

