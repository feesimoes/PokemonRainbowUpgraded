script Cherrygrove_Mart_EventScript_Cooltrainer_M
{
    lock
    applymovement(2, Cherrygrove_Mart_Face_Player)
    msgbox(format("I collect latest POKé MART merch,\neven if I don't need it.\pYou never know when something will\nbe more valuable later."))
    waitmessage
    closemessage
    release
    end
}

script Cherrygrove_Mart_EventScript_Lass
{
    lock
    applymovement(3, Cherrygrove_Mart_Face_Player)
    msgbox(format("The POKé MART is a convenient\nchain of stores worldwide.\pThe items they sell differ\ntown to town, but also overseas."))
    waitmessage
    closemessage
    release
    end
}

script Cherrygrove_Mart_EventScript_Little_Boy
{
    lock
    applymovement(1, Cherrygrove_Mart_Face_Player)
    msgbox(format("My sis is afraid of the dark!\nWe're shopping for HM05: FLASH!\pIt's supposed to light dark caves."))
    waitmessage
    closemessage
    release
    end
}

script Cherrygrove_Mart_EventScript_Little_Girl
{
    lock
    applymovement(6, Cherrygrove_Mart_Face_Player)
    msgbox(format("DARK CAVE is terrifying!\nIt's even worse without a POKéMON!"))
    waitmessage
    closemessage
    release
    end
}

movement Cherrygrove_Mart_Face_Player
{
    face_player
    step_end
}