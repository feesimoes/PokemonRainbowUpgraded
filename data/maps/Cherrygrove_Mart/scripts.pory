mapscripts Cherrygrove_Mart_MapScripts
{

}

script Cherrygrove_Mart_Clerk_1 
{
    lock
    applymovement(5, Cherrygrove_Mart_Face_Player)
    msgbox(format("Welcome to CHERRYGROVE POKé MART!\nHow can I help you?"))
    waitmessage
    pokemart(Cherrygrove_Mart_1)
    msgbox(format("Thanks for stopping by!\nPlease come again!"))
    release
    end
}

script Cherrygrove_Mart_Clerk_2
{
    lock
    applymovement(4, Cherrygrove_Mart_Face_Player)
    msgbox(format("Welcome to CHERRYGROVE POKé MART!\nHow can I help you?"))
    waitmessage
    pokemart(Cherrygrove_Mart_2)
    msgbox(format("Thanks for stopping by!\nPlease come again!"))
    release
    end
}

mart Cherrygrove_Mart_1 
{
    ITEM_RETRO_MAIL
    ITEM_HEAL_POWDER
    ITEM_NEST_BALL
    ITEM_REPEAT_BALL
}

mart Cherrygrove_Mart_2 
{
    ITEM_POKE_BALL
    ITEM_GREAT_BALL
    ITEM_ULTRA_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_HYPER_POTION
    ITEM_MAX_POTION
    ITEM_FULL_RESTORE
    ITEM_REVIVE
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_AWAKENING
