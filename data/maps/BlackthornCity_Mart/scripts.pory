mapscripts BlackthornCity_Mart_MapScripts {}

script BlackthornCity_Mart_Clerk_1 
{        
    lock
    faceplayer
    msgbox(format("Welcome to BLACKTHORN POKé MART!\nHow can I help you?"))
    waitmessage
    pokemart(Blackthorn_Mart_1)
    msgbox(format("Thanks for stopping by!\nPlease come again!"))
    closemessage
    release
    end
}

