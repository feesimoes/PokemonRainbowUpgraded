script BlackthornCity_Mart_Cooltrainer_M 
{
    lock
    faceplayer
    msgbox(format("This is it.\nThis is the final test.\pCLAIR'S GYM is the last\nobstacle before the-\pHuh? Those BADGES you have...\nAre from... KANTO?!"))
    closemessage
    release
    end
}