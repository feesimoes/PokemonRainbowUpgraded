raw `
SSAnne_Exterior_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SSAnne_Exterior_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, SSAnne_Exterior_OnFrame
	.byte 0

SSAnne_Exterior_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_SSANNE_EXTERIOR
	end

SSAnne_Exterior_OnFrame::
	map_script_2 VAR_MAP_SCENE_VERMILION_CITY, 1, SSAnne_Exterior_ExitSSAnne
	.2byte 0

SSAnne_Exterior_ExitSSAnne::
	lockall
	getplayerxy VAR_0x8004, VAR_0x8005
	call_if_le VAR_0x8005, 6, SSAnne_Exterior_WalkDown
	call_if_ge VAR_0x8005, 7, SSAnne_Exterior_WalkInPlaceDown
	fadenewbgm MUS_SURF
	delay 50
	special DoSSAnneDepartureCutscene
	waitstate
	removeobject LOCALID_SS_ANNE
	applymovement LOCALID_PLAYER, SSAnne_Exterior_Movement_Exit
	waitmovement 0
	setvar VAR_MAP_SCENE_VERMILION_CITY, 2
	setvar VAR_VERMILION_CITY_TICKET_CHECK_TRIGGER, 0
	warp MAP_VERMILION_CITY, 23, 34
	waitstate
	releaseall
	end

SSAnne_Exterior_WalkDown::
	applymovement LOCALID_PLAYER, SSAnne_Exterior_Movement_WalkDown
	waitmovement 0
	return

SSAnne_Exterior_WalkInPlaceDown::
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	return

SSAnne_Exterior_Movement_Exit::
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

SSAnne_Exterior_Movement_WalkDown::
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end
	
`
script VermilionHarbor_EventScript_SinnohFerry {
    if (flag(FLAG_SINNOH_PASS_OBTAINED))
    {
        lock
        msgbox(format("Welcome, {PLAYER}!\nPacked up and ready to go?\pC'mon! Let's set sail!\n"), MSGBOX_YESNO)
        waitmessage
	    if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Alright, I'll be here...\nCome back when you're ready!"))
            release
            end
        }
        else
        {
            msgbox(format("SINNOH awaits!\nC'mon, let's go!"))
            setvar(VAR_0x8004, SEAGALLOP_VERMILION_CITY)
            setvar(VAR_0x8006, SEAGALLOP_CANALAVE_CITY)
            closemessage
            delay(20)
            fadescreen(FADE_TO_BLACK)
            special(DoSeagallopFerryScene)
            waitstate
            release
            end
        }
    }
    else 
    {
        lock
        msgbox(format("You want a ride? Sorry, kiddo!\nYou'll need V.I.P.'s approval!\pWho?\n...Well, she's busy!\pHeard she's interviewing {RIVAL}\nin SAFFRON'S SILPH CO.!\pAlthough, eh...\nShe should've been back by now..."))
        waitmessage
        closemessage
        release
        end
    }
}

script VermilionHarbor_EventScript_JohtoFerry
{
	lock
	msgbox(format("You want a ride?\nOh... Sorry, but...\pSomething serious is going on in\nour usual route, you see.\pWhirlpools and treacherous storms\npaused such travel, for now."))	
	waitmessage
	closemessage
	release
	end
}

script VermilionHarbor_EventScript_GuyanaFerry 
{
	lock
	msgbox(format("Don't just stand there, mate!\nKeep loading the truck!"))
	waitmessage
	if (var(VAR_MEW_QUEST_PROGRESS) > 3)
	{
		applymovement(LOCALID_GUYANA_FERRYMAN, VermilionHarbor_EventScript_GuyanaFerry_NoticePlayer)
		faceplayer
		waitmovement
		msgbox(format("Ah, {PLAYER}!\nYou're back?\pDid you want to return\nto the GUYANA REGION?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES)
		{
			msgbox(format("Hope you're prepared!\nI'll try to make it quick."))
			setvar(VAR_0x8004, SEAGALLOP_VERMILION_CITY)
			setvar(VAR_0x8006, SEAGALLOP_LINDEN_TOWN)
			closemessage
			delay(20)
			fadescreen(FADE_TO_BLACK)
			special(DoSeagallopFerryScene)
			waitstate
		}
		else
		{
			msgbox(format("Understood, have a nice day."))
			waitmessage
			applymovement(LOCALID_GUYANA_FERRYMAN, VermilionHarbor_EventScript_GuyanaFerry_FaceRight)
			waitmovement
			closemessage
		}
	}
	else
	{
		closemessage
	}
	release
	end
}

movement VermilionHarbor_EventScript_GuyanaFerry_NoticePlayer 
{
	emote_exclamation_mark
	step_end
}

movement VermilionHarbor_EventScript_GuyanaFerry_FaceRight 
{
	face_right
	step_end
}

script VermilionHarbor_EventScript_MrFuji 
{
	if (var(VAR_MEW_QUEST_PROGRESS) == 3)
	{
		lock
		faceplayer
		msgbox(format("Hm...\n{PLAYER}, welcome.\pI do apologize for the confusion,\nif any...\pQuizzes sure do have a nifty way\nof keeping our minds sharp!"))
		closemessage
		applymovement(LOCALID_VERMILION_MR_FUJI, VermilionHarbor_EventScript_GuyanaFerry_FaceRight)
		waitmovement
		msgbox(format("BLAINE, my dear friend...\nIt was so good to see you.\pTake care in your journey, the\nGUYANA REGION can be...\pVery unforgiving, to say least..."))
		msgbox(format("GIOVANNI will use the harsh,\nunfamiliar ecosystem to advantage.\p{PLAYER} is in good hands...\nTheir heart is true."))
		closemessage
		fadescreen(FADE_TO_BLACK)
		removeobject(LOCALID_VERMILION_MR_FUJI)
		setflag(FLAG_HIDE_VERMILION_MR_FUJI)
		fadescreen(FADE_FROM_BLACK)
		getplayerxy(VAR_TEMP_8, VAR_TEMP_9)
		if (var(VAR_TEMP_9) == 5)
		{
			applymovement(LOCALID_PLAYER, Movement_VermilionHarbor_WalkUp_FaceRight)
			waitmovement
		}
		else
		{
			applymovement(LOCALID_PLAYER, Movement_VermilionHarbor_WalkRight)
			waitmovement
		}
		msgbox(format("Hah!\nWell, you heard the doctor!\pSo, are you ready?\nBAG stocked up, and all?"), MSGBOX_YESNO)
		waitmessage
		if (var(VAR_RESULT) == YES)
		{
			setvar(VAR_MEW_QUEST_PROGRESS, 4)
			setflag(FLAG_HIDE_VERMILION_BLAINE)
			msgbox(format("Hah! I'll burn the way forward!\nFear not!"))
			waitmessage
			applymovement(LOCALID_VERMILION_BLAINE, VermilionHarbor_EventScript_GuyanaFerry_FaceRight)
			waitmovement
			msgbox(format("Ahem!\nWe're ready..."))
			waitmessage
			applymovement(LOCALID_GUYANA_FERRYMAN, VermilionHarbor_EventScript_GuyanaFerry_NoticePlayer)
			waitmovement
			setvar(VAR_0x8004, SEAGALLOP_VERMILION_CITY)
			setvar(VAR_0x8006, SEAGALLOP_LINDEN_TOWN)
			closemessage
			delay(20)
			fadescreen(FADE_TO_BLACK)
			special(DoSeagallopFerryScene)
			waitstate
			removeobject(LOCALID_VERMILION_BLAINE)
		}
		else
		{
			msgbox(format("Hah! Don't be afraid!\nI'm capable of helping you!\pSee, my plan is simple...\nI'll burn the way forward!\pTrees cannot use BURN HEAL, and so\nGIOVANNI will be exposed!"))
			msgbox(format("Trust me, it's perfectly safe!\nI've done the sort before.\pCome back when you're ready!"))
			closemessage
		}
		release
		end
	}
	else 
	{
		lock
		faceplayer
		msgbox(format("Hmm... Wait a second!\nI'm not supposed to be here."))
		closemessage
		setflag(FLAG_HIDE_VERMILION_MR_FUJI)
		setflag(FLAG_HIDE_VERMILION_BLAINE)
		release
		end
	}
}

movement Movement_VermilionHarbor_WalkRight 
{
	walk_right
	step_end	
}

movement Movement_VermilionHarbor_WalkUp_FaceRight
{
	walk_up
	face_right
	step_end	
}

script VermilionHarbor_EventScript_Blaine 
{
	lock
	faceplayer
	msgbox(format("Hah, {PLAYER}!\nReady now?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES)
	{
		setvar(VAR_MEW_QUEST_PROGRESS, 4)
		setflag(FLAG_HIDE_VERMILION_BLAINE)
		waitmessage
		applymovement(LOCALID_VERMILION_BLAINE, VermilionHarbor_EventScript_GuyanaFerry_FaceRight)
		waitmovement
		msgbox(format("Ahem!\nWe're ready..."))
		waitmessage
		applymovement(LOCALID_GUYANA_FERRYMAN, VermilionHarbor_EventScript_GuyanaFerry_NoticePlayer)
		setvar(VAR_0x8004, SEAGALLOP_VERMILION_CITY)
		setvar(VAR_0x8006, SEAGALLOP_LINDEN_TOWN)
		waitmovement
		closemessage
		delay(20)
		fadescreen(FADE_TO_BLACK)
		special(DoSeagallopFerryScene)
		waitstate
		removeobject(LOCALID_VERMILION_BLAINE)
	}
	else
	{
		msgbox(format("Hah, don't be afraid!\nCome back if you're ready!\pI'll be here, thinking about how to...\nAhem, safely... Expose GIOVANNI..."))
		closemessage
	}
	release
	end
}