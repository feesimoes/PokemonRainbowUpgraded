    faceplayer
    msgbox(format("These slots are tough to win\nat... Battle strategies are useless!"))
    closemessage
    release
    end
}

script GoldenrodCity_GameCorner_Rocker
{
    lock
    faceplayer
    msgbox(format("I'm racking up my wins here\nfor some neat item prizes."))
    closemessage
    release
    end
}

script GoldenrodCity_GameCorner_Gentleman
{
    lock
    faceplayer
    msgbox(format("I'm only here on behalf of\nmy grandson, ah... uh,\pWhat was his name again...?"))
    closemessage
    release
    end
}

script GoldenrodCity_GameCorner_Woman_3
{
    lock
    faceplayer
    msgbox(format("You're from KANTO?\nOh?! You must be joking... No?!\pTEAM ROCKET runs CELADON's GAME\nCORNER? Buttons behind posters?!"))
    closemessage
    release
    end
}

script GoldenrodCity_GameCorner_Balding_Man
{
    lock
    faceplayer
    msgbox(format("What do you want?\nEh?\pWell, I can assure you that\nthere's no hidden buttons here."))
    closemessage
    release
    end
}

script GoldenrodCity_GameCorner_Gym_Guide
{
    lock
    faceplayer
    msgbox(format("Yo!\nWORLD CHAMP in the making!\pThese slots may be tough, but\nuse the same KANTO strategy!\pOh, and TEAM ROCKET doesn't run\nthis GAME CORNER!"))
    closemessage
    release
    end
}