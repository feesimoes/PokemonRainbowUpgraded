mapscripts Route32_Bay_Bounty_House_MapScripts
{

}

script Butch_Bounty_Hunter_Dialogue {
    lock
    msgbox(format("It's about time\nya got here, rookie!"))
    waitmessage
    closemessage
    applymovement(1, Movement_Butch_Face_Player)
    special(GetBountyTaskMonAndReward)
    msgbox(format("So, here's the deal, see...\nI need a {STR_VAR_1}!\pBut not just any! Make sure\nit's LV.{STR_VAR_2}, in a {STR_VAR_3} BALL."))
    waitmessage
    closemessage
    msgbox(format("Maybe I misjudged ya!\nHave you brought it in?"), MSGBOX_YESNO)
    waitmessage
    if (var(VAR_RESULT) == YES)
    {
        msgbox(format("Good, hand it over then!"))
        waitmessage
        closemessage
        special(ChoosePartyMon)
        waitstate
        msgbox(format("Let's see..."))
        waitmessage
        closemessage
        special(CheckMonClaimBountyTaskReward)
        if (var(VAR_BOUNTY_TASK_MON) == 0)
        {
            msgbox(format("Here's your payment, as promised."))
            waitmessage
            closemessage
            special(GetBountyTaskMonAndReward)
            msgbox(format("Before I let you go,\nI'll need a {STR_VAR_1}!\pBut not just any! Make sure\nit's LV.{STR_VAR_2}, in a {STR_VAR_3} BALL.\pGet to work, rookie!"))
            waitmessage
            closemessage
        }
        else
        {
            msgbox(format("That's not right...\nGet to work, rookie!\pAlso, make sure you have\nat least 2 PARTY POKéMON."))
            waitmessage
            closemessage
        }
    }
    else
    {
        closemessage
        msgbox(format("If you need tips on your task,\nI'm sure CASSIDY can help.\pShe'd be around here, on\nsort of a remote island.\pSo, get to work, rookie!"))
        waitmessage
        closemessage
    }
    releaseall
    end
}

movement Movement_Butch_Face_Player {
    face_player
    step_end
}

movement Movement_Butch_Notice_Player_Emote {
    emote_exclamation_mark
    step_end
}