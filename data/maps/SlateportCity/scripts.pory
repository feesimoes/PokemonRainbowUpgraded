mapscripts SlateportCity_MapScripts {}

script SlateportCity_Sign 
{
    lock
    msgbox(format("SLATEPORT CITY -\nA bustling port city!\pPeople from different regions\ngather and mingle here."))    
    closemessage
    release
    end
}

