script SlateportCity_Sailor
{
    lock
    faceplayer
    checkitem(ITEM_HM08, 1)
    if (var(VAR_RESULT) == TRUE)
    {
        msgbox(format("When using SURF over a body\nof water, the darker water...\pUse DIVE on those spots to\ngo underwater!"))
        msgbox(format("If you need to return to the\nsurface, just use DIVE again!\pYou can't always re-surface in\nany spot, though. Be careful!"))
    }
    else
    {
        msgbox(format("You definitely seem capable of...\nHm? You don't have HM08: DIVE?!\pYou're lucky I keep extras!\nHere, take this!"))
        giveitem(ITEM_HM08, 1)
        msgbox(format("When using SURF over a body of\nwater, there are these...\pWell, deep, spots of water.\nYou can DIVE underwater, too!"))
        msgbox(format("Although, in most cases, DIVE\nunderwater takes you back up...\pI wonder why there isn't really\na separate HM for that?"))
    }
    closemessage
    release
    end
}

script SlateportCity_SecretHiddenPowerClerk
{
    lock
    faceplayer
    msgbox(format("Oh, you found me!"))    
    pokemart(SlateportCity_SecretHiddenTMItems)
    msgbox(format("Please keep my location a\nsecret, okay?\p...Or tell everyone, your choice!\n...It's good for business..."))
    closemessage
    release
    end
}

mart SlateportCity_SecretHiddenTMItems 
{
    ITEM_TM10
    ITEM_TM43    
    ITEM_NONE
}

script SlateportCity_SecretBase_FurnitureClerk
{
    lock
    faceplayer
    msgbox(format("I've got a wide range of\nfurniture for sale!\pDoes anything interest you for\nyour SECRET BASE?"))    
    pokemartdecoration(SlateportCity_SecretBase_FurnitureDecorItems)
    msgbox(format("Please come again!"))
    closemessage
    release
    end
}

