script NewBarkTown_ProfessorElmsLab_Aide_1_Dialogue
{
    lock
    applymovement(3, Movement_ProfessorElmsLabNPCFacesPlayer)
    msgbox(format("I help PROF. ELM with his research.\nHe gets distracted easily."))
    closemessage
    releaseall
    end
}

script NewBarkTown_ProfessorElmsLab_Aide_2_Dialogue
{
    lock
    applymovement(4, Movement_ProfessorElmsLabNPCFacesPlayer)
    msgbox(format("You're compiling a POKéDEX, too?\nInteresting..."))
    closemessage
    releaseall
    end
}

script NewBarkTown_ProfessorElmsLab_Heal_Dialogue
{
    lock
    applymovement(2, Movement_ProfessorElmsLabNPCFacesPlayer)
    msgbox(format("Hello!\nI can heal your POKéMON.\pWould you like me to restore\nyour POKéMON to full health?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES)
    {
        closemessage
        msgbox(format("I'll take your POKéMON for one\nquick moment, then..."))
        closemessage
        call(EventScript_OutOfCenterPartyHeal)
        msgbox(format("Your POKéMON have been fully\nhealed. Good luck out there!"))
        closemessage
    }
    else
    {
        closemessage
        msgbox(format("Got it, no worries!\nI'll be here."))
        closemessage
    }
    releaseall
    end
}

script NewBarkTown_ProfessorElmsLab_Elm_Dialogue
{
    lock
    if (flag(FLAG_MEW_QUEST_STARTED))
    {
        applymovement(1, Movement_ProfessorElmsLabNPCFacesPlayer)
        if (var(VAR_MEW_QUEST_PROGRESS) == 10)
        {
            msgbox(format("{PLAYER}! There you are!\nI heard of your adventure!\pI'm just glad the POKéGEAR'S\ndevelopment may resume..."))
            msgbox(format("Oh, that reminds me!\nAs a bit of a welcome gift...\pHow about you pick a partner?\nThese POKéMON are extremely rare!"))
            msgbox(format("Go on.\nPick one from the table!"))
            closemessage
            setvar(VAR_MEW_QUEST_PROGRESS, 11)
        }
        elif (var(VAR_MEW_QUEST_PROGRESS) == 11)
        {
            msgbox(format("Think it over carefully...\nYour partner is important!"))
            closemessage
        }
        else
        {
            msgbox(format("Hi, {PLAYER}!\nHow are you doing?\pIf your POKéMON get hurt, you\ncan heal them here, too!\pPlease speak with my wife by\nthe machine there."))
            closemessage
        }
        releaseall
        end    
    }
    else
    {
        lock
        msgbox(format("Hmm... What's this?\nEmail from...\pUh-huh... I see..."))
        closemessage
        if (!flag(FLAG_SYS_NATIONAL_DEX))
        {
            msgbox(format("Ah! PROF. OAK is there?\nThis is fascinating!\pI'd better get-"))
            closemessage
            applymovement(1, Movement_ProfessorElmNoticesPlayer)
            waitmovement
            applymovement(1, Movement_ProfessorElmsLabNPCFacesPlayer)
            waitmovement
            msgbox(format("Uh, hi!\nWho are you?\p{PLAYER}? It's nice to meet you!\nYour timing is perfect, actually!\pI'm PROF. ELM, by the way!"))
            msgbox(format("An associate of mine, MR. POKéMON,\njust sent me a lengthy email.\pIf you'd be so kind to\nassist, I would appreciate it!"))
            msgbox(format("I see that you have POKéMON already,\nso this should be easy, right?\pJust head west to CHERRYGROVE CITY.\nHis house is north from there!"))
            msgbox(format("Oh, right! On your way there,\nstop by the POKéMON CENTER.\pMake sure you have free\nspace in your party."))
            applymovement(1, Movement_ProfessorElmNoticesPlayer)
            waitmovement
            msgbox(format("Oh, wait!\nI almost forgot!"))
            msgbox(format("SILPH CO. has resumed operations,\nand recently sent me an email."))
            msgbox(format("They were looking for help testing\ntheir new prototype device.\pThey need experienced TRAINERS,\na specific criteria you fit!"))
            msgbox(format("Ah... I apologize!\nWe've only just met...\pI hope it's not too much to\nask of you!"))
            closemessage
        }
        else
        {
            applymovement(1, Movement_ProfessorElmNoticesPlayer)
            waitmovement
            applymovement(1, Movement_ProfessorElmsLabNPCFacesPlayer)
            waitmovement
            msgbox(format("Uh, hi!\nWho are you?\p{PLAYER}? It's nice to meet you!\nYour timing is perfect, actually!\pI'm PROF. ELM, by the way!"))
            msgbox(format("SILPH CO. has resumed operations,\nand recently sent me an email."))
            msgbox(format("They were looking for help testing\ntheir new prototype device.\pThey need experienced TRAINERS,\na specific criteria you fit!"))
            msgbox(format("Ah... I apologize!\nWe've only just met...\pI hope it's not too much to\nask of you!"))
            closemessage
        }
        setflag(FLAG_MEW_QUEST_STARTED)
        setvar(VAR_JOHTO_STORY_PROGRESS, 1)
        releaseall
        end
    }
}

movement Movement_ProfessorElmNoticesPlayer
{
    emote_exclamation_mark
    step_end    
}

movement Movement_ProfessorElmsLabNPCFacesPlayer
{
    face_player
    step_end    
}

script NewBarkTown_ProfessorElmsLab_Computer 
{
    lock
    msgbox(format("It's a bunch of numbers and symbols\nthat seem almost like a puzzle..."))    
    closemessage
    release
    end
}

script NewBarkTown_ProfessorElmsLab_BreedingEvolutionSign 
{
    lock
    msgbox(format("Some POKéMON cannot be caught or\nfound in typical field research.\pMALE and FEMALE POKéMON may often\nbring EGGS to their trainer."))
    msgbox(format("From recent studies, these EGGS will\nalmost always hatch with time.\pWhat hatches seems to depend on the\nfirst stages of a POKéMON'S species."))    
    closemessage
    release
    end
}

script NewBarkTown_ProfessorElmsLab_WorldChampionshipSign 
{
    lock
    msgbox(format("Not every REGION has a POKéMON\nLEAGUE, while some do share them.\pSome far-off known REGIONS, such as\nALOLA or GUYANA, lack a LEAGUE."))
    msgbox(format("Some technical exceptions lie in\nKANTO, JOHTO, and SEVII REGIONS.\pIt's rare, but exceptional TRAINERS\ncan earn more than 8 GYM BADGES."))
    msgbox(format("LEGENDARY TRAINERS with a hefty\nstack of BADGES need expert skills.\pThey earn the right to participate\nin the POKéMON WORLD TOURNAMENT!"))
    closemessage
    release
    end    
}
