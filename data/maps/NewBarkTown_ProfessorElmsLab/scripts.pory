mapscripts NewBarkTown_ProfessorElmsLab_MapScripts
{
    MAP_SCRIPT_ON_LOAD
    {
        setworldmapflag(FLAG_WORLD_MAP_NEW_BARK_TOWN)
    }
}

script NewBarkTown_ProfessorElmsLab_Chikorita_Ball 
{
    lock
    if (var(VAR_MEW_QUEST_PROGRESS) == 11)
    {
        textcolor(NPC_TEXT_COLOR_MALE)
        setvar(VAR_0x8000, SPECIES_CHIKORITA)
        setvar(VAR_0x8001, 5)
        callnative(Native_GeneratePreviewMon)
        setvar(VAR_0x8002, 10)
        setvar(VAR_0x8003, 3)
        callnative(Native_ShowPreviewMon)
		if (flag(FLAG_GOT_SHINY_POKEMON) == TRUE)
		{
			playse(SE_SHINY)
			waitse
		}
        msgbox(format("You'll take CHIKORITA, right?\nIt's a GRASS-TYPE POKéMON."), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
            msgbox(format("I think that's a great POKéMON,\ntoo! Thanks, {PLAYER}!"))
            hidemonpic
            callnative(Native_GivePreviewMon)
            textcolor(NPC_TEXT_COLOR_NEUTRAL)
            if (flag(FLAG_GOT_SHINY_POKEMON) == TRUE)
            {
                msgbox(format("CHIKORITA looks exceptionally rare...\nWoah, it's a SHINY POKéMON!"))
                clearflag(FLAG_GOT_SHINY_POKEMON)
            }
            textcolor(NPC_TEXT_COLOR_MALE)
            if (var(VAR_RESULT) == 0)
            {
                playfanfare(MUS_LEVEL_UP)
                waitfanfare
                setflag(FLAG_JOHTO_CHOSE_CHIKORITA)
                removeobject(LOCALID_CHIKORITA_BALL)
                hidemonpic
                call(EventScript_GetGiftMonPartySlot)
                msgbox(format("Will you give that CHIKORITA\na nickname?"), MSGBOX_YESNO)
                if (var(VAR_RESULT) == YES)
                {
                    call(EventScript_ChangePokemonNickname)
                }
            }
            elif (var(VAR_RESULT) == 1)
            {
                playfanfare(MUS_LEVEL_UP)
                waitfanfare
                setflag(FLAG_JOHTO_CHOSE_CHIKORITA)
                removeobject(LOCALID_CHIKORITA_BALL)
                hidemonpic
                msgbox(format("Will you give that CHIKORITA\na nickname?"), MSGBOX_YESNO)
                if (var(VAR_RESULT) == YES)
                {
                    call(EventScript_NameReceivedBoxMon)
                    msgbox(format("Looks like it was sent to\none of your PC boxes, {PLAYER}!"))
                }
                else
                {
                    msgbox(format("Seems that CHIKORITA got sent to\none of your PC boxes, {PLAYER}!"))
                }
            }
            else
            {
                hidemonpic
                clearflag(FLAG_GOT_SHINY_POKEMON)
                msgbox(format("...What's this?\nSorry, you've got no room!"))
            }
            if (!flag(FLAG_SYS_NATIONAL_DEX))
            {
                msgbox(format("Oh, right!\nI almost forgot...\pMR. POKéMON is still waiting\nfor you on ROUTE 30."))
            }
            setvar(VAR_MEW_QUEST_PROGRESS, 12)
            closemessage
        }
        else
        {
            hidemonpic
            clearflag(FLAG_GOT_SHINY_POKEMON)
            msgbox(format("Think it over, carefully.\nYour partner is important!"))
            closemessage
        }
    }
    else
    {
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        msgbox(format("Better not get greedy..."))
        closemessage
    }
    release
    end
}

