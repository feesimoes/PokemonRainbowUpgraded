mapscripts Route32_PokemonCenter_1F_MapScripts
{
    MAP_SCRIPT_ON_LOAD
    {
        setworldmapflag(FLAG_WORLD_MAP_ROUTE32_POKEMON_CENTER_1F)
    }
    MAP_SCRIPT_ON_TRANSITION
    {
        setrespawn(HEAL_LOCATION_ROUTE32)
    }
    MAP_SCRIPT_ON_RESUME
    {
        call(CableClub_OnResume)
    }
}

script Route32_PokemonCenter_1F_Attendant_Out_Of_Service
{
    lock
    applymovement(5, Movement_Route32_PokemonCenter_1F_Face_Player)
    msgbox(format("I'm terribly sorry, but we\nare undergoing some maintenance."))
    release
    end
}

script Route32_PokemonCenter_1F_EventScript_Nurse
{
	lock
    faceplayer
    call(EventScript_PkmnCenterNurse)
	release
	end
}

movement Movement_Route32_PokemonCenter_1F_Face_Player
{
    face_player
    step_end
}
