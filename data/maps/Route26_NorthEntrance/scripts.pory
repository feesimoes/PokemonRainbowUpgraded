mapscripts Route26_NorthEntrance_MapScripts {}

script Route26_NorthEntrance_Guard_1 
{
    lock
    faceplayer
    msgbox(format("Oh, hello.\nIt's rare that we get visitors...\pPlease, go on ahead! You must\nbe a very strong TRAINER."))
    closemessage
    releaseall
    end
}

script Route26_NorthEntrance_Guard_2 
{
    lock
    faceplayer
    msgbox(format("Wow, a visitor!\nIt's rare to see another TRAINER!\pROUTE 28 is up ahead, it\nleads to JOHTO'S MT. SILVER."))
    closemessage
    releaseall
    end
}

script Route26_NorthEntrance_Badge_Guard
{
    lock
    applymovement(LOCALID_ROUTE28_GATE_GUARD, Movement_Route26_NorthEntrance_Badge_Guard_Face_Player)
    waitmovement
    if (flag(FLAG_JOHTO_BADGE01_GET))
    {
        msgbox(format("...Oh!\nThat is the ZEPHYRBADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_LEVEL_UP}{PAUSE 0x60}{RESUME_MUSIC}\pOkay, then.\nPlease, go right ahead."))
        setvar(VAR_MAP_SCENE_ROUTE28, 1)
        waitmessage
        closemessage
        applymovement(LOCALID_ROUTE28_GATE_GUARD, Movement_Route26_NorthEntrance_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
    else
    {
        msgbox(format("Only truly skilled TRAINERS are\nallowed through.\pYou don't have the ZEPHYRBADGE\nyet! Sorry, rules are rules.\pI can't let you pass."))
        waitmessage
        closemessage
        applymovement(LOCALID_ROUTE28_GATE_GUARD, Movement_Route26_NorthEntrance_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
}

script Route26_NorthEntrance_Badge_Guard_Trigger
{
    lock
    applymovement(LOCALID_ROUTE28_GATE_GUARD, Movement_Route26_NorthEntrance_Badge_Guard_Face_Player)
    waitmovement
    msgbox(format("Halt!"))
    waitmessage
    if (flag(FLAG_JOHTO_BADGE01_GET))
    {
        msgbox(format("...Oh!\nThat is the ZEPHYRBADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_LEVEL_UP}{PAUSE 0x60}{RESUME_MUSIC}\pOkay, then.\nPlease, go right ahead."))
        setvar(VAR_MAP_SCENE_ROUTE28, 1)
        waitmessage
        closemessage
        applymovement(LOCALID_ROUTE28_GATE_GUARD, Movement_Route26_NorthEntrance_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
    else
    {
        msgbox(format("Only truly skilled TRAINERS are\nallowed through.\pYou don't have the ZEPHYRBADGE\nyet! Sorry, rules are rules.\pI can't let you pass."))
        waitmessage
        closemessage
        applymovement(LOCALID_PLAYER, Movement_Route26_NorthEntrance_Walk_Down_1)
        waitmovement
        applymovement(LOCALID_ROUTE28_GATE_GUARD, Movement_Route26_NorthEntrance_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
}

movement Movement_Route26_NorthEntrance_Badge_Guard_Face_Player
{
    face_player
    step_end   
}

movement Movement_Route26_NorthEntrance_Badge_Guard_Face_Down
{
    face_down
    step_end   
}

movement Movement_Route26_NorthEntrance_Walk_Down_1
{
    walk_down
    step_end   
}