mapscripts BlackthornCity_MoveSpecialists_House_MapScripts {}

script BlackthornCity_Move_Deleter 
{
    lock
    faceplayer
    msgbox(format("...What was I doing again?\nUh... Oh, right!\pI'm a MOVE DELETER!\nI'll tell you what!\pNo charge, completely covered!\nWant a POKéMON to forget moves?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO)
    {
        msgbox(format("No?\nNo to what, exactly?\pOh, right!\nI'm a MOVE DELETER!\pI'll tell you what!\n...What was I doing again?"))
    }
    else 
    {
        msgbox(format("Which POKéMON will forget a move?"))
        closemessage
        special(ChoosePartyMon)
    	waitstate
        special(IsSelectedMonEgg)
        if (var(VAR_RESULT) == TRUE)
        {
            msgbox(format("I think that's just an\nEGG... Which came first?\pThe POKéMON, or the EGG?\nI forgot, anyways..."))
        }
        special(GetNumMovesSelectedMonHas)
        if (var(VAR_RESULT) == 1)
        {
            msgbox(format("Your POKéMON only knows\none move...\pWithout any moves, it'll\nSTRUGGLE in battle."))
        }
        msgbox(format("Which move should be forgotten?"))
        fadescreen(FADE_TO_BLACK)
        special(SelectMoveDeleterMove)
        fadescreen(FADE_FROM_BLACK)
        special(BufferMoveDeleterNicknameAndMove)
        msgbox(format("{STR_VAR_1}'s {STR_VAR_2}\nmove should be forgotten?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
	        special(MoveDeleterForgetMove)
	        playfanfare(MUS_MOVE_DELETED)
	        waitfanfare
            msgbox(format("{STR_VAR_1} has forgotten\n{STR_VAR_2} completely.\pFeel free to return here\nwhenever!"))
        }
        else
        {
            msgbox(format("Alright, you can come back\nlater, if you want."))
        }
    }
    closemessage
    release
    end
}

script BlackthornCity_Move_Reminder 
{
    lock
    faceplayer
    msgbox(format("Hey, I'm a MOVE REMINDER! I\ncan remind POKéMON of old moves.\pIt's a free service, too!\nSo, how about it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO)
    {
        msgbox(format("Gotcha!\nNo worries, then.\pIf you change your mind,\nRemember to come back!"))
    }
    else 
    {
        msgbox(format("Sounds good! So...\nWhich POKéMON will remember a move?"))
        closemessage
        special(ChooseMonForMoveRelearner)
        waitstate
        special(IsSelectedMonEgg)
        if (var(VAR_RESULT) == TRUE)
        {
            msgbox(format("Huh? Sorry, but...\nAn EGG has nothing to remember..."))
        }
        elif (var(VAR_0x8005) == 0)
        {
            msgbox(format("Unfortunately, this POKéMON has\nlots more to learn!\pThere is nothing I can remind\nit of at this time."))
        }
        else 
        {
            msgbox(format("You got it!\nWhich move should it remember?"))
            special(TeachMoveRelearnerMove)
            waitstate
        }
    }
    closemessage
    release
    end
}