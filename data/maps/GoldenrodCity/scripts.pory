script GoldenrodCity_Woman_1
{
    lock
    faceplayer
    msgbox(format("Hi! Um...\nAre you okay?\pYou look worried... TEAM ROCKET?\nNo, they aren't here...\pThe JOHTO GAME CORNER is run\nby GOLDENROD CITY'S people!"))
    closemessage
    release
    end
}

script GoldenrodCity_Woman_2
{
    lock
    faceplayer
    msgbox(format("It might be a silly name\nfor it, but...\pYou definitely need a SQUIRT BOTTLE\nto pass by those weird trees."))
    closemessage
    release
    end
}

script GoldenrodCity_Lass
{
    lock
    faceplayer
    msgbox(format("Huh, you're from KANTO?\nI've been there, actually...\pTo be honest, it's just a\nbit disappointing..."))
    msgbox(format("For starters, you know, everything\nin KANTO is basic and overpriced.\pThere's a BICYCLE SHOP here too,\nso, take a good look around!"))
    closemessage
    release
    end
}

script GoldenrodCity_Beauty
{
    lock
    faceplayer
    msgbox(format("If you haven't seen GOLDENROD'S\nDEPT. STORE, it's a must!\pEspecially for TRAINERS!\nThey have almost everything!"))
    closemessage
    release
    end
}

script GoldenrodCity_Balding_Man
{
    lock
    faceplayer
    msgbox(format("MIRACLE CYCLE does wonders with\nany kind of BICYCLE!\pI left my broken BICYCLE with\nthem for a day...\pCame back, and... Wow!\nGood as new! No charge at all!"))
    closemessage
    release
    end
}

script GoldenrodCity_Boy
{
    lock
    faceplayer
    msgbox(format("A mini-device that can play my\nfavorite RADIO CHANNEL anywhere...\pHonestly, that would be sweet.\nI think SILPH CO.'S on it!"))
    closemessage
    release
    end
}

script GoldenrodCity_GuardTom
{
    lock
    faceplayer
    msgbox(format("GOLDENROD CITY... It's generally\npretty safe...\pI don't question it, though.\nThe pay here's slightly better."))
    closemessage
    release
    end
}

script GoldenrodCity_GuardJerry
{
    lock
    faceplayer
    msgbox(format("My associate is honestly the\nonly threat to my peace...\pI need more time off..."))
    closemessage
    release
    end
}

script GoldenrodCity_LittleGirl
{
    lock
    faceplayer
    msgbox(format("Oh, you know BILL?!\nThat's awesome!\pHe needs to come visit us\nagain soon! I miss him!"))
    closemessage
    release
    end
}
