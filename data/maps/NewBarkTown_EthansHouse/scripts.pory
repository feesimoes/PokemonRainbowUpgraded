mapscripts NewBarkTown_EthansHouse_MapScripts {}

script NewBarkTown_EthansHouse_Mom_Dialogue
{
    lock
    applymovement(1, Movement_EthansHouse_NPC_FacesPlayer)
    msgbox(format("Kids eventually grow up and\nleave home someday, toughening up."))
    closemessage
    releaseall
    end
}

script NewBarkTown_EthansHouse_Ethan_Dialogue
{
    lock
    applymovement(2, Movement_EthansHouse_NPC_FacesPlayer)
    msgbox(format("You must be a strong trainer!\nI wanna be a trainer too!"))
    closemessage
    releaseall
    end
}

movement Movement_EthansHouse_NPC_FacesPlayer
{
    face_player
    step_end    
}