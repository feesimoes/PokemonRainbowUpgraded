raw `
SilphCo_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SilphCo_1F_OnTransition
	.byte 0

SilphCo_1F_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_SILPH_CO_1F
	end

SilphCo_1F_EventScript_Receptionist::
	msgbox SilphCo_1F_Text_WelcomePresidentInBoardroom, MSGBOX_NPC
	end

SilphCo_1F_EventScript_FloorSign::
	msgbox SilphCo_1F_Text_FloorSign, MSGBOX_SIGN
	end

`

movement Movement_Cynthia_Faces_Player {
    face_player
    step_end
}

script SilphCo_1F_EventScript_CynthiaEncounter {
    if (flag(FLAG_HIDE_SILPH_ROCKETS))
    {
        lock
        applymovement(2, Movement_Cynthia_Faces_Player)
        waitmovement
        playbgm(MUS_CYNTHIA, TRUE)
        msgbox(format("Oh, is that a POKéDEX?\nYou must be helping PROF. OAK!\pSo, what's your name?\p...Oh! Aren't you the same {PLAYER}\nwho drove TEAM ROCKET out of here?"))
        waitmessage
        msgbox(format("My name is CYNTHIA,\nI'm a TRAINER just like you."))
        waitmessage
        msgbox(format("You seem to be a strong\nand respectable TRAINER...\p...OK, it's decided!"))
        msgbox(format("Now, I know I'm asking a big favor\nof you, but you are very capable.\pPlease visit VERMILION HARBOR'S\neasternmost port.\pThere will be a ferry to SINNOH."))
        waitmessage
        msgbox(format("I'm truly grateful for your actions\nhere at SILPH CO.\pNow, SINNOH is an entirely different\nregion due far north of KANTO.\pBe prepared for a lengthy journey\n...Oh, and bring warm clothes!\pWe'll meet again soon, {PLAYER}!"))
        waitmessage
        closemessage
        fadenewbgm(MUS_KANTO_ROUTE_GATE)
        setflag(FLAG_SINNOH_PASS_OBTAINED)
        fadescreen(FADE_TO_BLACK)
        removeobject(2)
        fadescreen(FADE_FROM_BLACK)
        release
        end
    }
    else
    {
        lock
        msgbox(format("Somebody needs to help me!!!\nI'm stuck in here!!! HELP!"))
        closemessage
        applymovement(2, Movement_Cynthia_Faces_Player)
        waitmovement
        msgbox(format("Oh, hello...\nWait, no, you aren't with SILPH...\pI'm sorry, I thought you were the\nperson I was here to interview..."))
        closemessage
        release
        end
    }
}

script SilphCo_1F_EventScript_StevenEncounter
{
    lock
    faceplayer
    msgbox(format("My name is STEVEN. I'm the CHAMPION\nfrom the HOENN REGION.\pHave we... Met... Before?\nNo, that's not possible..."))
    msgbox(format("All the TRAINERS I have battled\nseem to have that same look..."))
    msgbox(format("Oh, look at the time.\nI really must go.\pPlus, I appear to have run out of\nuseful dialogue for you..."))
    closemessage
    release
    end
}
