script Fisherman_Jacob_Route26_Battle {
    trainerbattle_single(TRAINER_FISHERMAN_JACOB, format("I have better POKéMON than\nyou, kiddo!"), format("Tch... Well, at least my\nPOKéMON are more unique!"))
    msgbox(format("Your team was pretty neat.\nWhere'd you catch them?"))
    closemessage
    releaseall
    end
}

script Fisherman_Bradley_Route26_Battle {
    trainerbattle_single(TRAINER_FISHERMAN_BRADLEY, format("Not even a nibble...\nKid, you're scaring them!"), format("There's no way I'd ever\nthrow a tip your way!"))
    msgbox(format("I only paid you because\nyou are a POKéMON TRAINER.\pThere's a FISHING GURU\nin KANTO, by the way."))
    closemessage
    releaseall
    end
}

script Route26_EventScript_CooltrainerMarcos
{
    trainerbattle(TRAINER_BATTLE_SINGLE, TRAINER_COOLTRAINER_MARCOS, 0,
        Route26_Text_CooltrainerMarcosIntro,
        Route26_Text_CooltrainerMarcosDefeated)
    msgbox(format("Boa batalha! Voce eh forte."))
    closemessage
    releaseall
    end
}

text Route26_Text_CooltrainerMarcosIntro
{
    format("Voce veio de Kanto?\pImpressionante. Mas aqui em\nJohto as regras sao outras!")
}

text Route26_Text_CooltrainerMarcosDefeated
{
    format("Nao esperava isso...\pVoce realmente eh o Campeao.")
}

script TRIGGER_SCRIPT_TEST_1 {
    lockall
    playse(SE_PIN)
    applymovement(4, movement_camper1)
    waitmovement(0)
    if (var(VAR_TEMP_6) == 2) {
        msgbox(format("You again?\pNah this time we battle for real!"))
        trainerbattle_no_intro(TRAINER_RUIN_MANIAC_LAWSON, format("Damn, I lost the battle…"))
        closemessage
        setvar(VAR_TEMP_5, 1) // THis will prevent it from triggering again.
        releaseall
        end
    }
    msgbox(format("Hey I think we should battle..\pWhat do you think?"), MSGBOX_YESNO)
    if (var(VAR_RESULT))
    { 
        msgbox(format("Alright lets do this!"))
        trainerbattle_no_intro(TRAINER_RUIN_MANIAC_LAWSON, format("Damn, I lost the battle…"))
    }
    else {
        msgbox(format("Eh, you suck."))
        closemessage
        setvar(VAR_TEMP_6, 2)
        setvar(VAR_TEMP_5, 0) // But also allows for extra chat options if you trigger the same again.
        releaseall
        end
    }
    msgbox(format("Hey man that was a crazy battle, I cannot beleieve you won."))
    closemessage
    setvar(VAR_TEMP_5, 1) // THis will prevent it from triggering again.
    releaseall
    end
}

movement movement_camper1 {
    emote_double_exclamation_mark
    step_end
}

script Test_Script_1 {
    lock
    msgbox(format("PLACEHOLDER TEXT.")) //format("") will automatically format the font so you don't need to do \p \n \l and format it constantly.
    closemessage
    release
    end
}


script Test_Movement_Script_1 {
    lock
    playse(SE_PIN)
    applymovement(1, movement_RocketRunAway1)
    applymovement(2, movement_RocketRunAway1)
    applymovement(3, movement_RocketRunAway1)
    playbgm(MUS_JESSIE_JAMES_THEME, FALSE)
    msgbox(format("It's that twerp!"))
    waitmovement(0)
    msgbox(format("Run away!"))
    closemessage
    playse(SE_FLEE)
    applymovement(1, movement_RocketRunAway2)
    applymovement(2, movement_RocketRunAway2)
    applymovement(3, movement_RocketRunAway2)
    waitmovement(0)

    setflag(FLAG_TEMP_1) //Make sure a Flag is set to the objects on the map you want to disappear.
    removeobject(1)
    removeobject(2)
    removeobject(3)
    release
    end
}

movement movement_RocketRunAway1 {
    emote_exclamation_mark
    jump_in_place_down
    step_end
}

movement movement_RocketRunAway2 {
    walk_fast_down * 5
    step_end
}

movement movement_route26_npc_face_player {
    face_player
    step_end
}