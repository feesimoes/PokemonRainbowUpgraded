mapscripts Route26_MapScripts {
}

script Route26_Professor_Oak_Battle {
    trainerbattle_single(TRAINER_PKMN_PROF_PROF_OAK, format("Ah, {PLAYER}!\nGood to see you.\pBeyond this gate here is\nROUTE 28, it leads to MT. SILVER.\pIt's home to the toughest\nand rarest POKéMON!\pBut... I need to test your\nskills! Do you have what it takes?"), format("Hm... so, you are ready!"))
    msgbox(format("Please proceed to MT. SILVER!\nTake care in your journey!\pI'll be back at the LAB.\nDo check in sometime!"))
    setflag(FLAG_HIDE_PROF_OAK_RT26)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_PROF_OAK_RT26)
    fadescreen(FADE_FROM_BLACK)
    closemessage
    releaseall
    end
}

script Route26_Reception_Sign {
    msgbox(format("POKéMON LEAGUE RECEPTION GATE\nROUTE 28 - MT. SILVER"))
    closemessage
    releaseall
    end
}

script Picknicker_Jamie_Route26_Battle {
    trainerbattle_single(TRAINER_PICKNICKER_JAMIE_ROUTE26, format("Do you have rare POKéMON?\nShow me, show me!"), format("Yup, that's definitely a rare POKéMON!"))
    msgbox(format("It's too bad I don't have a POKéDEX.\nI wish I could get one!"))
    closemessage
    releaseall
    end
}

script Route26_Kanto_Biker_Dialogue {
    lock
    applymovement(2, movement_route26_npc_face_player)
    msgbox(format("You're from KANTO, aren't you?\nMe too!\pIt's a bit weird though, POKéMON\nfound here aren't from KANTO?\pINDIGO LEAGUE said so,\nor something..."))
    closemessage
    releaseall
    end
}

