mapscripts Route26_MapScripts {
}

script Route26_Professor_Oak_Battle {
    trainerbattle_single(TRAINER_PKMN_PROF_PROF_OAK, format("Ah, {PLAYER}!\nGood to see you.\pBeyond this gate here is the\nROUTE 28, it leads to MT. SILVER.\pIt's home to the toughest\nPOKéMON! But...\pI need to test if you\nhave what it takes!"), format("Hm, so... you are ready!"))
    msgbox(format("Please proceed to MT. SILVER!\nTake care in your journey!"))
    setflag(FLAG_HIDE_PROF_OAK_RT26)
    closemessage
    releaseall
    end
}

script Picknicker_Jamie_Route26_Battle {
    trainerbattle_single(TRAINER_PICKNICKER_JAMIE_ROUTE26, format("Do you have rare Pokémon from Kanto?\nShow me, show me!"), format("Yup, that's definitely a rare Pokémon!"))
    msgbox(format("It's too bad I don't have a Pokédex.\nI wish I could get one!"))
    closemessage
    releaseall
    end
}

script Kanto_Biker_Dialogue {
    lock
    msgbox(format("You're from KANTO, aren't you?\pMe too, I'm part of the KANTO RIDER FEDERATION!\pIt's a shame though, all Pokémon\non this route aren't considered\nlegit by the INDIGO LEAGUE..."))
    closemessage
    releaseall
    end
}

script TRIGGER_SCRIPT_TEST_1 {
    lockall
    playse(SE_PIN)
    applymovement(4, movement_camper1)
    waitmovement(0)
    if (var(VAR_TEMP_6) == 2) {
        msgbox(format("You again?\pNah this time we battle for real!"))
        trainerbattle_no_intro(TRAINER_RUIN_MANIAC_LAWSON, format("Damn, I lost the battle…"))
        closemessage
        setvar(VAR_TEMP_5, 1) // THis will prevent it from triggering again.
        releaseall
        end
    }
    msgbox(format("Hey I think we should battle..\pWhat do you think?"), MSGBOX_YESNO)
    if (var(VAR_RESULT))
    { 
        msgbox(format("Alright lets do this!"))
        trainerbattle_no_intro(TRAINER_RUIN_MANIAC_LAWSON, format("Damn, I lost the battle…"))
    }
    else {
        msgbox(format("Eh, you suck."))
        closemessage
        setvar(VAR_TEMP_6, 2)
        setvar(VAR_TEMP_5, 0) // But also allows for extra chat options if you trigger the same again.
        releaseall
        end
    }
    msgbox(format("Hey man that was a crazy battle, I cannot beleieve you won."))
    closemessage
    setvar(VAR_TEMP_5, 1) // THis will prevent it from triggering again.
    releaseall
    end
}

movement movement_camper1 {
    emote_double_exclamation_mark
    step_end
}

script Test_Script_1 {
    lock
    msgbox(format("PLACEHOLDER TEXT.")) //format("") will automatically format the font so you don't need to do \p \n \l and format it constantly.
    closemessage
    release
    end
}


script Test_Movement_Script_1 {
    lock
    playse(SE_PIN)
    applymovement(1, movement_RocketRunAway1)
    applymovement(2, movement_RocketRunAway1)
    applymovement(3, movement_RocketRunAway1)
    playbgm(MUS_JESSIE_JAMES_THEME, FALSE)
    msgbox(format("It's that twerp!"))
    waitmovement(0)
    msgbox(format("Run away!"))
    closemessage
    playse(SE_FLEE)
    applymovement(1, movement_RocketRunAway2)
    applymovement(2, movement_RocketRunAway2)
    applymovement(3, movement_RocketRunAway2)
    waitmovement(0)

    setflag(FLAG_TEMP_1) //Make sure a Flag is set to the objects on the map you want to disappear.
    removeobject(1)
    removeobject(2)
    removeobject(3)
    release
    end
}

movement movement_RocketRunAway1 {
    emote_exclamation_mark
    jump_in_place_down
    step_end
}

movement movement_RocketRunAway2 {
    walk_fast_down * 5
    step_end
}