script Route1_HoOh_Event_Move_Rival_5_Left {
    if (flag(!FLAG_ROUTE1_HO_OH_EVENT_HAPPENED) == FALSE) {
        lock
        applymovement(Route1_Rival, move_left_5)
        goto(Route1_HoOh_Event_Direct)
