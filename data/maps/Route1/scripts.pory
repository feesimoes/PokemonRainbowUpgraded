mapscripts Route1_MapScripts 
{

}

script Route1_EventScript_RouteSign 
{
    lock
    msgbox(format("ROUTE 1\nPALLET TOWN - VIRIDIAN CITY"))
    closemessage
    release
    end    
}

script Route1_EventScript_Boy
{
    lock
    faceplayer
    msgbox(format("See those ledges along the road?"))
    msgbox(format("It's a bit scary, but you can jump\nfrom them."))
    msgbox(format("You can get back to PALLET TOWN\nmuch quicker that way."))
    closemessage
    release
    end    
}

script Route1_EventScript_MartClerk
{
    lock
    faceplayer
    if (!flag(FLAG_GOT_POTION_ON_ROUTE_1))
    {
        msgbox(format("Hi!\nI work at the POKé MART.\pHave you checked it out in\nVIRIDIAN CITY yet?"))
        msgbox(format("Oh, I know!\nI'll give you free samples.\pIt's definitely a big help for\nnew TRAINERS like you.\pHere you go!"))
        textcolor(NPC_TEXT_COLOR_NEUTRAL)
        checkitemspace(ITEM_POTION, 5)
        if (var(VAR_RESULT) == TRUE)
        {
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox(format("{PLAYER} obtained five POTION(s)\nfrom the POKé MART clerk."))
            waitfanfare
            waitmessage
            additem(ITEM_POTION, 5)
            msgbox(format("{PLAYER} put the POTION(s) away in\nthe BAG'S ITEMS POCKET."))
            textcolor(NPC_TEXT_COLOR_MALE)
            msgbox(format("Stop by a POKé MART to shop,\nany time you want!\pWe aren't exclusive to KANTO!"))
            setflag(FLAG_GOT_POTION_ON_ROUTE_1)
        }
    }
    else
    {
        msgbox(format("Oh, it's you again!\nI was about to head back...\pYou can visit us any time you\nwant! We buy and sell products."))
        msgbox(format("We aren't exclusive to KANTO\neither, by the way.\pThere are more stores in many\nother regions, it's worldwide!"))
    }
    closemessage
    release
    end 
}

script Route1_Spearows_Bite {
    lock
    msgbox(format("It's a wild POKéMON!\nDarn! No way to ID it!"))
    closemessage
    setweather(WEATHER_RAIN)
    doweather
    faceplayer
    playmoncry(SPECIES_SPEAROW, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("Ow!\nIt gave you a vicious PECK!"))
    closemessage
    release
    end
}

script Route1_Misty_Thinks_You_Are_Rival {
    lock
    msgbox(format("Argh!\n...How annoying!"))
    closemessage
    faceplayer
    setweather(WEATHER_RAIN)
    doweather
    msgbox(format("...Oh?\nAre you that pest's friend...?\pAre you going to apologize?!"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES)
    {
        msgbox(format("Ugh, I never thought that new\nTRAINERS from PALLET TOWN would...\pOh, never mind that!"))
        msgbox(format("I'm a decent TRAINER, but I can't\nlie, there's more to learn!"))
        msgbox(format("I also love WATER-type POKéMON!\nI was fishing here, but..."))
        msgbox(format("I can't seem to reel in any POKéMON\nat all... Aww...\pIt's getting a bit dark too, so\nI'll probably go back to CERULEAN..."))
        msgbox(format("You're a new face!\nUh huh...\pOkay, so you're {PLAYER}!\nI'll remember that!\pI'm MISTY! Here, come with me!\nI could show you to VIRIDIAN CITY!"))
        closemessage
    }
    else
    {
        msgbox(format("Tch...\nSeriously?!\pIf I even wanted your apology, I\nwould have asked for it!"))
        msgbox(format("I came here for POKéMON, not to be\nbullied by new TRAINERS!"))
        msgbox(format("I can't seem to reel in any POKéMON\nat all... Aww...\pIt's getting a bit dark too, so I'll\nprobably go back to CERULEAN..."))
        closemessage
        checkplayergender
        if (var(VAR_RESULT) == MALE)
        {
            msgbox(format("You're a new face, though!\nUh huh... Okay...\pWow, you're {PLAYER}'ERY'UHH-GURL?\nWow! I forgot already..."))
            msgbox(format("Anyways, I'm MISTY! Come with me!\nI have to show you VIRIDIAN CITY!"))
        }
        else
        {
            msgbox(format("You're a new face, though!\nUh huh... Okay...\pWow, you're {PLAYER}'ERR'UHH-MAN?\nWow! I forgot already..."))
            msgbox(format("Anyways, I'm MISTY! Come with me!\nI have to show you VIRIDIAN CITY!"))
        }
    }
    closemessage
    playbgm(MUS_FOLLOW_ME, TRUE)
    applymovement(LOCALID_ROUTE1_MISTY, Route1_Misty_Sequence_1)
    delay(4)
    applymovement(LOCALID_PLAYER, Route1_Player_Follow_Sequence_1)
    waitmovement
    setweather(WEATHER_SUNNY)
    doweather
    applymovement(LOCALID_ROUTE1_MISTY, Route1_Movement_Face_Player)
    waitmovement
    msgbox(format("Well, would you look at that?\nThe rain has finally let up!\pCome on, just a bit more to go!"))
    closemessage
    playmoncry(SPECIES_HO_OH, CRY_MODE_NORMAL)
    waitmoncry
    applymovement(LOCALID_PLAYER, Route1_Player_Sequence_1)
    waitmovement
    applymovement(LOCALID_ROUTE1_MISTY, Route1_Misty_Sequence_2)
    waitmovement
    msgbox(format("I'm all the way over here,\nSLOWPOKE! By the big red building!"))
    closemessage
    applymovement(LOCALID_PLAYER, Route1_Player_Sequence_2)
    waitmovement
    msgbox(format("We're here!\nThis is the POKéMON CENTER.\pNURSE JOY is always happy to heal\nYour POKéMON to full health!\pThe best part is that it's free!"))
    msgbox(format("Anyways, I'll be seeing you!\nI gotta go over to a POKé MART!\pBe sure to meet lots of POKéMON!\nLet's meet again, alright?"))
    closemessage
    removeobject(LOCALID_ROUTE1_MISTY)
    addobject(LOCALID_VIRIDIAN_MISTY)
    applymovement(LOCALID_VIRIDIAN_MISTY, Viridian_Misty_Sequence_1)
    waitmovement
    setflag(FLAG_ROUTE1_HO_OH_EVENT_HAPPENED)
    removeobject(LOCALID_VIRIDIAN_MISTY)
    release
    end
}

movement Route1_Misty_Sequence_1
{
    walk_up * 11
    walk_right * 3
    walk_up * 3
    walk_left * 3
    walk_up * 5
    step_end
}

movement Route1_Player_Follow_Sequence_1
{
    walk_up * 12
    walk_right * 3
    walk_up * 3
    walk_left * 3
    walk_up * 4
    step_end
}

movement Route1_Misty_Sequence_2
{
    walk_up * 6
    set_invisible
    step_end
}

movement Viridian_Misty_Sequence_1
{
    walk_right * 4
    walk_up * 7
    step_end
}

movement Route1_Player_Sequence_1
{
    emote_question_mark
    delay_8
    face_left
    delay_16
    delay_16
    face_right
    delay_16
    delay_16
    face_down
    delay_16
    delay_16
    face_left
    delay_16
    delay_16
    face_right
    delay_16
    delay_16
    face_down
    delay_16
    delay_16
    face_left
    delay_16
    emote_exclamation_mark
    face_up
    step_end
}

movement Route1_Player_Sequence_2
{
    player_run_up * 6
    player_run_left * 2
    player_run_up * 2
    player_run_left * 15
    player_run_up * 4
    walk_up
    step_end
}

