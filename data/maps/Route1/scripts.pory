        end
    }
}

movement move_face_player {
    face_player
    step_end
}

movement move_face_down {
    face_down
    step_end
}

movement exclaimation_mark {
    emote_exclamation_mark
    step_end
}

movement move_up_1 {
    walk_up
    step_end
}

movement move_face_left_fast {
    face_left_fast
    step_end
}

movement move_left_1 {
    walk_left
    step_end
}
movement move_left_2 {
    walk_left * 2
    step_end
}
movement move_left_3 {
    walk_left * 3
    step_end
}
movement move_left_4 {
    walk_left * 4
    step_end
}

movement move_left_5 {
    walk_left * 5
    step_end
}

movement move_left_16 {
    walk_left * 16
    step_end
}
movement run_left_16 {
    walk_faster_left * 16
    step_end
}

movement move_right_16 {
    walk_right * 16
    step_end
}