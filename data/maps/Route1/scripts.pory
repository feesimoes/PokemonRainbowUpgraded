raw `
Route1_MapScripts::
	.byte 0

Route1_EventScript_MartClerk::
	lock
	faceplayer
	goto_if_set FLAG_GOT_POTION_ON_ROUTE_1, Route1_EventScript_AlreadyGotPotion
	msgbox Route1_Text_WorkAtPokeMartTakeSample
	textcolor NPC_TEXT_COLOR_NEUTRAL
	checkitemspace ITEM_POTION
	goto_if_eq VAR_RESULT, FALSE, EventScript_BagIsFull
	bufferitemname STR_VAR_2, ITEM_POTION
	playfanfare MUS_LEVEL_UP
	message Text_ObtainedTheX
	waitmessage
	waitfanfare
	additem ITEM_POTION
	msgbox Route1_Text_PutPotionAway
	call EventScript_RestorePrevTextColor
	setflag FLAG_GOT_POTION_ON_ROUTE_1
	release
	end

Route1_EventScript_AlreadyGotPotion::
	msgbox Route1_Text_ComeSeeUsIfYouNeedPokeBalls
	release
	end

Route1_EventScript_Boy::
	msgbox Route1_Text_CanJumpFromLedges, MSGBOX_NPC
	end

Route1_EventScript_RouteSign::
	msgbox Route1_Text_RouteSign, MSGBOX_SIGN
	end
`
const Route1_Misty = 0x08
const Route1_HoOh = 0x03

script Route1_Spearows_Bite {
    lock
    playmoncry(SPECIES_SPEAROW, CRY_MODE_NORMAL)
    msgbox(format("It's a wild POKéMON!\nDarn! Couldn't ID it!\p"))
    setweather(WEATHER_RAIN)
    doweather
    msgbox(format("Ow!\nIt gave you a vicious PECK!"))
    waitmessage
    release
    end
}

script Route1_Misty_Thinks_You_Are_Rival {
    lock
    applymovement(Route1_Misty, Route1_Movement_Face_Player)
    setweather(WEATHER_RAIN)
    doweather
    msgbox(format("Argh! How annoying!\n...Oh? Well, welcome back, pest!\pAre you returning my BIKE?"), MSGBOX_YESNO)
    msgbox(format("...Huh? I appreciate that\nunexpected honesty, but...\pSorry, I've had a rough day!\nSome loser took off with my BIKE!"))
    setweather(WEATHER_RAIN_THUNDERSTORM)
    doweather
    msgbox(format("I can't seem to reel in any\ngood POKéMON here either!\pIt's getting a bit dark, too, so\nI'll probably head back to CERULEAN."))
    msgbox(format("You're a new face!\nUh huh...\pOK, so you're {PLAYER}!\nI'll remember that!\pI'm MISTY! Here, come with me!\nI could show you to VIRIDIAN CITY!"))
    waitmessage
    applymovement(Route1_Misty, Route1_Movement_Walk_Up_9)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Up_9)
    waitmovement
    msgbox(format("Argh!\nWhat's with these FLYING POKéMON?\pI can't find any WATER types!"))
    waitmessage
    playmoncry(SPECIES_HO_OH, CRY_MODE_NORMAL)
    waitmoncry
    setweather(WEATHER_SUNNY)
    doweather
    applymovement(Route1_Misty, Route1_Movement_Walk_Right_3)
    waitmovement
    applymovement(Route1_Misty, Route1_Movement_Walk_Up_1)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Up_1)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Right_3)
    waitmovement
    applymovement(Route1_Misty, Route1_Movement_Walk_Up_5)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Up_5)
    waitmovement
    msgbox(format("Well, would you look at that?\nThe rain has finally let up!\pCome on, just a bit more to go!"))
    waitmessage
    closemessage
    applymovement(Route1_Misty, Route1_Movement_Walk_Left_2)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Left_2)
    waitmovement
    applymovement(Route1_Misty, Route1_Movement_Walk_Up_5)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Up_5)
    waitmovement
    applymovement(Route1_Misty, Route1_Movement_Walk_Up_5)
    waitmovement
    applymovement(Route1_Misty, Route1_Movement_Walk_Right_18)
    waitmovement
    msgbox(format("I'm all the way over here,\nSLOWPOKE! By the big red building!"))
    closemessage
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Up_7)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Left_18)
    waitmovement
    applymovement(LOCALID_PLAYER, Route1_Movement_Walk_Up_5)
    waitmovement
    msgbox(format("We're here!\nThis is the POKéMON CENTER.\pNURSE JOY is always happy to heal\nYour POKéMON to full health!\pThe best part is that it's free!"))
    waitmessage
    msgbox(format("I'm gonna go over to the POKéMART!\nI definitely need to stock up\pon supplies now, since ROUTE 1.\nOK, see ya!\pBe sure to meet lots of POKéMON!"))
    applymovement(10, Route1_Movement_Walk_Right_18)
    waitmessage
    waitmovement
    removeobject(10)
    setflag(FLAG_ROUTE1_HO_OH_EVENT_HAPPENED)
    release
    end
}

