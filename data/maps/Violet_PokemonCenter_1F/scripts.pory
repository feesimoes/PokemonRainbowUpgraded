mapscripts Violet_PokemonCenter_1F_MapScripts
{
    MAP_SCRIPT_ON_LOAD
    {
        setworldmapflag(FLAG_WORLD_MAP_VIOLET_CITY)
    }
    MAP_SCRIPT_ON_TRANSITION
    {
        setrespawn(HEAL_LOCATION_VIOLET_CITY)
    }
    MAP_SCRIPT_ON_RESUME
    {
        call(CableClub_OnResume)
    }
}

script Violet_PokemonCenter_1F_Attendant_Out_Of_Service
{
    lock
    applymovement(5, Movement_Violet_PokemonCenter_1F_Face_Player)
    msgbox(format("I'm terribly sorry, but we\nare undergoing some maintenance."))
    release
    end
}

script Violet_PokemonCenter_1F_EventScript_Nurse
{
	lock
    faceplayer
    call(EventScript_PkmnCenterNurse)
	release
	end
}

script Violet_PokemonCenter_1F_Man
{
    lock
    applymovement(7, Movement_Violet_PokemonCenter_1F_Face_Player)
    msgbox(format("WALKER has been the GYM LEADER\nfor as long as I can remember.\pBut... I think his son, FALKNER,\nwould be a good successor."))
    waitmessage
    closemessage
    release
    end
}

script Violet_PokemonCenter_1F_Picnicker
{
    lock
    applymovement(6, Movement_Violet_PokemonCenter_1F_Face_Player)
    msgbox(format("I can't tell you how many\ntimes I lost to this GYM...\pNo, really!\nI lost track of my losses."))
    waitmessage
    closemessage
    release
    end
}

movement Movement_Violet_PokemonCenter_1F_Face_Player
{
    face_player
    step_end
}
