mapscripts SlateportCity_Harbor_MapScripts {}

script SlateportCity_Harbor_FerryToGuyana 
{
    lock
    faceplayer
    msgbox(format("Would you like to head\nout to the GUYANA REGION?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES)
    {
        msgbox(format("Let's set sail!"))
        setvar(VAR_0x8004, SEAGALLOP_SLATEPORT_CITY)
        setvar(VAR_0x8006, SEAGALLOP_KAIETEUR_JUNGLE)
        waitmessage
        closemessage
        delay(20)
        fadescreen(FADE_TO_BLACK)
        special(DoSeagallopFerryScene)
        waitstate
        release
        end
    }
    else
    {
        msgbox(format("No worries, I'll be here."))
        closemessage
        release
        end
    }
}

script SlateportCity_Harbor_Sailor 
{
    lock
    faceplayer
    msgbox(format("Hmm...\nThat's a lot of BADGES.\pIf you don't have HM08: DIVE yet,\nmaybe someone's got extras...\pHave you checked out the MARKET?"))
    closemessage
    release
    end    
}

script SlateportCity_Harbor_Fat_Man
{
    lock
    faceplayer
    msgbox(format("You came all the way from\nKANTO? Phew...\pMust be nice having SEAGALLOP, huh?\nI wish STERN built some!"))
    closemessage
    release
    end    
}

script SlateportCity_Harbor_Super_Nerd
{
    lock
    faceplayer
    msgbox(format("SLATEPORT is the busiest spot in\nHOENN. Naturally, stay on guard.\pBeware of those PIRATE scoundrels...\nTEAM CORSAIR is no joke!"))
    closemessage
    release
    end    
}