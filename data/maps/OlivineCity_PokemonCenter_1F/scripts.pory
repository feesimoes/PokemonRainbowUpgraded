mapscripts OlivineCity_PokemonCenter_1F_MapScripts 
{
    MAP_SCRIPT_ON_LOAD
    {
        setworldmapflag(FLAG_WORLD_MAP_OLIVINE_CITY_POKEMON_CENTER_1F)
    }
    MAP_SCRIPT_ON_TRANSITION
    {
        setrespawn(HEAL_LOCATION_OLIVINE_CITY)
    }
    MAP_SCRIPT_ON_RESUME
    {
        call(CableClub_OnResume)
    }
}

script OlivineCity_PokemonCenter_1F_Attendant_Out_Of_Service
{
    lock
    faceplayer
    msgbox(format("I'm terribly sorry, but we\nare undergoing some maintenance."))
    closemessage
    release
    end
}

script OlivineCity_PokemonCenter_1F_EventScript_Nurse
{
	lock
    faceplayer
    call(EventScript_PkmnCenterNurse)
	release
	end
}