mapscripts LindenTown_Mart_MapScripts {}

script LindenTown_Mart_Clerk 
{
    lock
    faceplayer
    msgbox(format("Welcome to LINDEN POKé MART!\nHow may I help you?"))
    pokemart(LindenTown_Mart)
    msgbox(format("Come again!"))
    closemessage
    release
    end
}

mart LindenTown_Mart 
{
    ITEM_POKE_BALL
    ITEM_PREMIER_BALL
    ITEM_GREAT_BALL
    ITEM_ULTRA_BALL
    ITEM_NEST_BALL
    ITEM_NET_BALL
    ITEM_TIMER_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_HYPER_POTION
    ITEM_MAX_POTION
    ITEM_FULL_RESTORE
    ITEM_REVIVE
    ITEM_MAX_REVIVE
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_AWAKENING
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_FULL_HEAL
    ITEM_REPEL
    ITEM_SUPER_REPEL
    ITEM_MAX_REPEL
    ITEM_ESCAPE_ROPE
    ITEM_POKE_DOLL
    ITEM_LAVA_COOKIE
}

script LindenTown_Mart_Tuber_M_Land 
{
    lock
    faceplayer
    msgbox(format("Everything's so expensive here!\nMy papa says it's a...\pPOKé MART M-Muh...\nMonopoly, I think?"))
    closemessage
    release
    end
}