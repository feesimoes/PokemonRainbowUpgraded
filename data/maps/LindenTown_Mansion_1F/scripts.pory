movement LindenTown_Mansion_1F_Face_Left 
{
    face_left
    step_end    
}
movement LindenTown_Mansion_1F_Walk_Left 
{
    walk_left
    step_end    
}

movement LindenTown_Mansion_1F_Face_Right 
{
    face_right
    step_end    
}

movement LindenTown_Mansion_1F_Walk_Right 
{
    walk_right
    step_end    
}

movement LindenTown_Mansion_1F_Face_Up 
{
    face_up
    step_end    
}

movement LindenTown_Mansion_1F_Face_Down 
{
    face_down
    step_end    
}