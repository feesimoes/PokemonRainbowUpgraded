mapscripts GoldenrodCity_MagnetTrainStation_MapScripts 
{
    MAP_SCRIPT_ON_LOAD
    {
        checkitem(ITEM_MUSIC_PLAYER, 1)
        if (var(VAR_RESULT) == TRUE)
        {
            setflag(FLAG_TEMP_1)
        }
        playbgm(MUS_GOLDENROD, TRUE)
    }
}

script GoldenrodCity_Badge_Guard
{
    lock
    applymovement(LOCALID_GOLDENRODCITY_GUARD, Movement_GoldenrodCity_Badge_Guard_Face_Player)
    waitmovement
    if (flag(FLAG_JOHTO_BADGE03_GET))
    {
        msgbox(format("...Oh!\nThat is the PLAINBADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_LEVEL_UP}{PAUSE 0x60}{RESUME_MUSIC}\pOkay, then.\nPlease, go right ahead."))
        setvar(VAR_MAP_SCENE_SAFFRONTRAIN, 1)
        waitmessage
        closemessage
        applymovement(LOCALID_GOLDENRODCITY_GUARD, Movement_GoldenrodCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
    else
    {
        msgbox(format("Only truly skilled TRAINERS are\nallowed through.\pYou don't have the PLAINBADGE\nyet! Sorry, rules are rules.\pI can't let you pass."))
        waitmessage
        closemessage
        applymovement(LOCALID_GOLDENRODCITY_GUARD, Movement_GoldenrodCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
}

script GoldenrodCity_Badge_Guard_Trigger
{
    lock
    applymovement(LOCALID_GOLDENRODCITY_GUARD, Movement_GoldenrodCity_Badge_Guard_Face_Player)
    waitmovement
    msgbox(format("Halt!"))
    waitmessage
    if (flag(FLAG_JOHTO_BADGE03_GET))
    {
        msgbox(format("...Oh!\nThat is the PLAINBADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_LEVEL_UP}{PAUSE 0x60}{RESUME_MUSIC}\pOkay, then.\nPlease, go right ahead."))
        setvar(VAR_MAP_SCENE_SAFFRONTRAIN, 1)
        waitmessage
        closemessage
        applymovement(LOCALID_GOLDENRODCITY_GUARD, Movement_GoldenrodCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
    else
    {
        msgbox(format("Only truly skilled TRAINERS are\nallowed through.\pYou don't have the PLAINBADGE\nyet! Sorry, rules are rules.\pI can't let you pass."))
        waitmessage
        closemessage
        applymovement(LOCALID_PLAYER, Movement_GoldenrodStation_Walk_Down)
        waitmovement
        applymovement(LOCALID_GOLDENRODCITY_GUARD, Movement_GoldenrodCity_Badge_Guard_Face_Down)
        waitmovement
        releaseall
        end
    }
}

movement Movement_GoldenrodCity_Badge_Guard_Face_Player
{
    face_player
    step_end   
}

movement Movement_GoldenrodCity_Badge_Guard_Face_Down
{
    face_down
    step_end   
}

movement Movement_GoldenrodStation_Walk_Down
{
    walk_down
    step_end   
}
