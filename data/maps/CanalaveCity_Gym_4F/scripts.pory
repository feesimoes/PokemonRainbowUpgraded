mapscripts CanalaveCity_Gym_4F_MapScripts {}

script CanalaveCity_Gym_4F_EventScript_Byron_Battle_1 {
	trainerbattle_single(TRAINER_LEADER_BYRON, format("Ah, it isn't often that we get\na visitor from KANTO...\pWelcome to SINNOH, young TRAINER! I\nspent a long time on IRON ISLAND.\pMy speciality is... you guessed it!\nthe sturdy STEEL-TYPE POKéMON!\p{PLAY_BGM MUS_ENCOUNTER_GYM_LEADER}Gwahaha!\nI see, I see!\pYou aren't just a tourist!\nYou've gained CYNTHIA'S respect!\pI, BYRON, accept your challenge!"), format("Hm! My sturdy POKéMON, defeated!"), format(""), NO_MUSIC)
    if (!flag(FLAG_OBTAINED_ROCK_CLIMB_KIT))
    {
        msgbox(format("You were strong enough to take\ndown my prized team of POKéMON.\pEven though you are from KANTO,\nyou have earned it: the MINE BADGE!{PAUSE_MUSIC}{PLAY_BGM}{MUS_OBTAIN_BADGE}{PAUSE 0xFE}{PAUSE 0x56}{RESUME_MUSIC}"))
        closemessage
        msgbox(format("Here! Take this, too!"))
        closemessage
        setflag(FLAG_OBTAINED_ROCK_CLIMB_KIT)
        giveitem(ITEM_ROCK_CLIMB_KIT, 1)
        msgbox(format("That EXPLORER KIT will allow you to\nscale rocky cliffs, and dig deep underground.\pBe sure to put it to good use!"))
        closemessage
        releaseall
        end
    }
    else 
    {
        msgbox(format("This SINNOH region is vast!\nNow, why don't you head east?\pPast JUBILIFE CITY is OREBURGH CITY.\nThere, you will find my son, ROARK.\pHe's a bit new to this GYM thing,\nbut I'll let him know you're coming!"))
        closemessage
        releaseall
        end
    }
}
