mapscripts AzaleaTown_Mart_MapScripts {}

script AzaleaTown_Mart_Clerk_1 
{        
    lock
    faceplayer
    msgbox(format("Welcome to AZALEA POKé MART!\nHow can I help you?"))
    waitmessage
    pokemart(Azalea_Mart_1)
    msgbox(format("Thanks for stopping by!\nPlease come again!"))
    closemessage
    release
    end
}

script AzaleaTown_Mart_Clerk_2
{        
