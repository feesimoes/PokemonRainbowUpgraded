mapscripts NewBarkTown_MapScripts {}

script ProfessorElmsLab_Sign {
    lock
    msgbox(format("ELM POKéMON RESEARCH LAB"))
    release
    end
}

script NewBarkTown_Sign {
    lock
    msgbox(format("NEW BARK TOWN\nWinds of a new beginning!"))
    release
    end
}

script LyrasHouse_Sign {
    lock
    msgbox(format("LYRA's House"))
    release
    end
}

script EthansHouse_Sign {
    lock
    msgbox(format("ETHAN's House"))
    release
    end
}

script LadyWarningAboutGrassOutsideOfNewBarkTown
{   
    lock
    applymovement(1, Movement_NewBarkTown_Face_Player)
    msgbox(format("You shouldn't go walking into\ntall grass with no POKéMON.\pIt's not safe like that."))
    release
    end
}

script LittleGirlWonderingWhereYouAreFrom
{   
    lock
    applymovement(3, Movement_NewBarkTown_Face_Player)
    msgbox(format("Hey mister! Where are you from?\nPALLET TOWN? Where is that?\pOh, that's in KANTO?!\nI never knew!"))
    release
    end
}

script GentlemanIsTiredOfThisPlace
{   
    lock
    applymovement(2, Movement_NewBarkTown_Face_Player)
    msgbox(format("I've travelled the world.\nIt doesn't matter where you go.\pBut it's important to have\nculture that welcomes you."))
    release
    end
}

movement Movement_NewBarkTown_Face_Player {
    face_player
    step_end
}

movement Movement_NewBarkTown_Bill_Spots_Player
{
    face_player
    emote_exclamation_mark
    step_end
}

movement Movement_NewBarkTown_MovePlayerUp {
    walk_up
    step_end
}

movement Movement_NewBarkTown_MovePlayerDown {
    walk_down
    step_end
}

movement Movement_Bill_Leaves_New_Bark_Town {
    walk_left
    step_end
}