script LindenTown_Mansion_Guard_1
{
    lock
    faceplayer
    msgbox(format("Sorry, I'd love to chat...\nBut, I'm on guard duty."))
    closemessage
    applymovement(5, LindenTown_Mansion_Guard_Face_Down)
    waitmovement
    release
    end
}

script LindenTown_Mansion_Guard_2
{
    lock
    faceplayer
    msgbox(format("Sorry, I can't chat...\nI'm on guard duty."))
    closemessage
    applymovement(4, LindenTown_Mansion_Guard_Face_Down)
    waitmovement
    release
    end
}

script LindenTown_Mansion_Guards_RaiseSuspicion 
{
    lock
    applymovement(4, LindenTown_Mansion_Guard_Notice_Player)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox(format("Uh...\nExcuse me!"))
    waitmessage
    closemessage
    waitmovement
    applymovement(LOCALID_PLAYER, LindenTown_Mansion_Player_Face_Up)
    waitmovement
    applymovement(5, LindenTown_Mansion_Guard_Notice_Player)
    waitmovement
    applymovement(5, LindenTown_Mansion_Guard_Face_Right)
    waitmovement
    msgbox(format("This is private property... Do\nyou have business being here?\p...\n...Yes, yes, I see."))
    msgbox(format("Alright.\nYour story checks out...\pBLAINE is inside, waiting for\nyou, {PLAYER}. Good luck."))
    waitmessage
    applymovement(4, LindenTown_Mansion_Guard_Face_Down)
    waitmovement
    applymovement(5, LindenTown_Mansion_Guard_Face_Down)
    waitmovement
    closemessage
    setvar(VAR_MEW_QUEST_PROGRESS, 5)
    release
    end
}

movement LindenTown_Mansion_Guard_Face_Down 
{
    face_down
    step_end    
}

movement LindenTown_Mansion_Guard_Notice_Player 
{
    emote_exclamation_mark
    step_end    
}

movement LindenTown_Mansion_Guard_Face_Right 
{
    face_right
    step_end    
}

movement LindenTown_Mansion_Player_Face_Up 
{
    face_up
    step_end    
}

