mapscripts LindenTown_MapScripts {}

script LindenTown_Harbor_FerryToVermilionCity 
{
    lock
    faceplayer
    if (var(VAR_MEW_QUEST_PROGRESS) == 4)
    {
        msgbox(format("Well, we made it.\nBLAINE went running into town.\pSomething about getting a tip\nfrom some rich friends?"))
    }

    msgbox(format("Did you want to return\nto KANTO, VERMILION CITY?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES)
    {
        msgbox(format("Understood!\nLet's head out."))
        setvar(VAR_0x8004, SEAGALLOP_LINDEN_TOWN)
        setvar(VAR_0x8006, SEAGALLOP_VERMILION_CITY)
        waitmessage
        closemessage
        delay(20)
        fadescreen(FADE_TO_BLACK)
        special(DoSeagallopFerryScene)
        waitstate
    }
    else
    {
        msgbox(format("Alright, I'll be here..."))
        waitmessage
        closemessage
    }
    release
    end
}

script LindenTown_Fat_Man 
{
    lock
    faceplayer
    msgbox(format("Is this your first visit?\nPOKéMON LEAGUE? GYM BADGES?\pAs if the jungle isn't\nenough of a challenge..."))
    closemessage
