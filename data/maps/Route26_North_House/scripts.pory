mapscripts Route26_North_House_MapScripts {}

script Route26_Move_Reminder_Dialogue {
    lock
    applymovement(1, Route26_Move_Reminder_Face_Player)
    msgbox(format("If your POKéMON forget a move,\nI will gladly remind them!\pIt's free of charge!\nSo, how about it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO)
    {
        closemessage
        msgbox(format("Ah, alright!\nNo worries, then.\pIf you change your mind,\nRemember to come back!"))
    }
    else 
    {
        closemessage
        msgbox(format("Sounds good! So...\nWhich POKéMON will remember a move?"))
        closemessage
        special(ChooseMonForMoveRelearner)
        waitstate
        special(IsSelectedMonEgg)
        if (var(VAR_RESULT) == TRUE)
        {
            msgbox(format("Hm? I'm sorry, but...\nAn EGG has nothing to remember..."))
        }
        elif (var(VAR_0x8005) == 0)
        {
            msgbox(format("Unfortunately, this POKéMON has\nmuch more to learn!\pThere is nothing I can remind\nit of at this time."))
        }
        else 
        {
            msgbox(format("Certainly!\nWhich move shall it remember?"))
            special(TeachMoveRelearnerMove)
            waitstate
        }
    }
    closemessage
    releaseall
    end
}

movement Route26_Move_Reminder_Face_Player {
    face_player
    step_end
}