script VioletCity_School_Dummy_Notebook 
{
    lock
    msgbox(format("It's GARRETT'S personal notebook.\nHmm...\pWait, that can't be right!\nThey need an educational one...\pThere is a note attached:"))
    applymovement(LOCALID_VIOLET_SCHOOL_GARRETT, VioletCity_School_FaceUp)
    waitmovement
    applymovement(LOCALID_VIOLET_SCHOOL_GARRETT, VioletCity_School_ExclamationEmote)
    waitmovement
    msgbox(format("GARRETT was here!\nASHLEY is a dummy!\pSigned,\nEARL'S star pupil!"))
    closemessage
    release
    end
}

movement VioletCity_School_ExclamationEmote 
{
    emote_exclamation_mark    
    step_end
}

movement VioletCity_School_FaceUp
{
    face_up_fast    
    step_end
}

